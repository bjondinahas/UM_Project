@{
    ViewData["Title"] = Localizer["Page_AssignGrade"];
    ViewData["FormTitle"] = Localizer["Page_AssignGrade"];
    ViewData["FormIcon"] = "fa-star";
    var students = ViewBag.Students as List<UM_Project.Models.Student>;
    var courses = ViewBag.Courses as List<UM_Project.Models.Course>;
}

<div class="um-page">
    <partial name="_AdminFormHeader" />
    <div class="um-form-panel">
        <form method="post" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label class="form-label">@Localizer["Label_Student"]</label>
                <select name="studentId" class="form-select" required>
                    <option value="">@Localizer["Form_SelectStudent"]</option>
                    @if (students != null) { foreach (var s in students) { <option value="@s.StudentId">@s.FullName</option> } }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">@Localizer["Label_Course"]</label>
                <select name="courseId" class="form-select" required>
                    <option value="">@Localizer["Form_SelectCourse"]</option>
                    @if (courses != null) { foreach (var c in courses) { <option value="@c.CourseId">@c.CourseCode — @c.CourseName</option> } }
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label">@Localizer["Form_SelectGrade"]</label>
                <select name="value" class="form-select" required>
                    <option value="">@Localizer["Form_SelectGrade"]</option>
                    @for (int i = (int)(ViewBag.GradeMax ?? 5); i >= (int)(ViewBag.GradeMin ?? 1); i--) { <option value="@i">@i</option> }
                </select>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="um-btn-primary"><i class="fas fa-save"></i> Assign Grade</button>
                <a asp-action="Index" class="btn btn-light border">@Localizer["Common_Cancel"]</a>
            </div>
        </form>
    </div>
</div>
