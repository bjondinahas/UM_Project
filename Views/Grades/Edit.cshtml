@model UM_Project.Models.Grade
@{
    ViewData["Title"] = "Edit Grade";
    var students = ViewBag.Students as List<UM_Project.Models.Student>;
    var courses = ViewBag.Courses as List<UM_Project.Models.Course>;
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-white text-center py-3">
                    <h3 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Grade</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="Edit">
                        <input type="hidden" name="id" value="@Model.GradeId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <div class="form-floating mb-3">
                            <select name="studentId" class="form-select" required>
                                <option value="">-- Select Student --</option>
                                @if (students != null)
                                {
                                    foreach (var s in students)
                                    {
                                        <option value="@s.StudentId" selected="@(s.StudentId == Model.StudentId)">@s.FullName (@s.StudentNumber)</option>
                                    }
                                }
                            </select>
                            <label>Student</label>
                        </div>
                        <div class="form-floating mb-3">
                            <select name="courseId" class="form-select" required>
                                <option value="">-- Select Course --</option>
                                @if (courses != null)
                                {
                                    foreach (var c in courses)
                                    {
                                        <option value="@c.CourseId" selected="@(c.CourseId == Model.CourseId)">@c.CourseName (@c.CourseCode)</option>
                                    }
                                }
                            </select>
                            <label>Course</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input name="value" value="@Model.Value" type="number" min="5" max="10" step="1" class="form-control" placeholder="Grade (5-10)" required />
                            <label>Grade (5-10)</label>
                            <span asp-validation-for="Value" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
