@model UM_Project.Models.Grade
@{
    ViewData["Title"] = "Edit Grade";
    ViewData["FormTitle"] = "Edit Grade";
    ViewData["FormIcon"] = "fa-pen";
    var students = ViewBag.Students as List<UM_Project.Models.Student>;
    var courses = ViewBag.Courses as List<UM_Project.Models.Course>;
}

<div class="um-page">
    <partial name="_AdminFormHeader" />
    <div class="um-form-panel">
        <form method="post" asp-action="Edit">
            <input type="hidden" name="id" value="@Model.GradeId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label class="form-label">Student</label>
                <select name="studentId" class="form-select" required>
                    @if (students != null) { foreach (var s in students) { <option value="@s.StudentId" selected="@(s.StudentId == Model.StudentId)">@s.FullName</option> } }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Course</label>
                <select name="courseId" class="form-select" required>
                    @if (courses != null) { foreach (var c in courses) { <option value="@c.CourseId" selected="@(c.CourseId == Model.CourseId)">@c.CourseName</option> } }
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label">Grade (5–10)</label>
                <input name="value" value="@Model.Value" type="number" min="5" max="10" class="form-control" required />
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="um-btn-primary"><i class="fas fa-save"></i> Save Changes</button>
                <a asp-action="Index" class="btn btn-light border">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
