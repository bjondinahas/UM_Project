@model IEnumerable<UM_Project.Models.Grade>
@{
    ViewData["Title"] = "Grades";
    ViewData["PageTitle"] = "Grades";
    ViewData["PageIcon"] = "fa-star";
    ViewData["PageSubtitle"] = "Student grades and pass/fail status";
    ViewData["CreateController"] = "Grades";
    ViewData["CreateText"] = "Assign Grade";
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar">
            <input type="text" id="searchInput" class="form-control" placeholder="Search student or course..." />
        </div>
        <div class="table-responsive">
            <table class="um-table" id="dataTable">
                <thead>
                    <tr><th>Student</th><th>Course</th><th>Grade</th><th>Status</th><th>Date</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        var pass = g.Value >= 6;
                        <tr>
                            <td class="fw-semibold">@(g.Student?.FullName ?? "—")</td>
                            <td>@(g.Course?.CourseName ?? "—")</td>
                            <td><span class="um-badge @(pass ? "um-badge-green" : "um-badge-red")">@g.Value</span></td>
                            <td>@(pass ? "Pass" : "Fail")</td>
                            <td>@g.DateRecorded.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="um-actions">
                                    <a asp-action="Edit" asp-route-id="@g.GradeId" class="um-btn-sm um-btn-edit"><i class="fas fa-pen"></i> Edit</a>
                                    <button type="button" class="um-btn-sm um-btn-delete" onclick="showDeleteModal('@g.GradeId', 'this grade')"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<partial name="_DeleteModal" />
<partial name="_TableSearchScript" />
