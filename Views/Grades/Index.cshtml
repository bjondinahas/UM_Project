@model IEnumerable<UM_Project.Models.Grade>
@{
    ViewData["Title"] = Localizer["Nav_Grades"];
    ViewData["PageTitle"] = Localizer["Nav_Grades"];
    ViewData["PageIcon"] = "fa-star";
    ViewData["PageSubtitle"] = Localizer["Page_Grades_Subtitle"];
    ViewData["CreateController"] = "Grades";
    ViewData["CreateText"] = Localizer["Page_Grades_Create"];
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar">
            <input type="text" id="searchInput" class="form-control" placeholder="@Localizer["Search_Enrollments"]" />
        </div>
        <div class="table-responsive">
            <table class="um-table" id="dataTable">
                <thead>
                    <tr><th>@Localizer["Table_Student"]</th><th>@Localizer["Table_Course"]</th><th>@Localizer["Table_Grade"]</th><th>@Localizer["Table_Status"]</th><th>@Localizer["Table_Date"]</th><th>@Localizer["Common_Actions"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        var passMin = (int)(ViewBag.GradePassingMin ?? 3);
                        var pass = g.Value >= passMin;
                        <tr>
                            <td class="fw-semibold">@(g.Student?.FullName ?? "—")</td>
                            <td>@(g.Course?.CourseName ?? "—")</td>
                            <td><span class="um-badge @(pass ? "um-badge-green" : "um-badge-red")">@g.Value</span></td>
                            <td>@(pass ? "Pass" : "Fail")</td>
                            <td>@g.DateRecorded.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="um-actions">
                                    <a asp-action="Edit" asp-route-id="@g.GradeId" class="um-btn-sm um-btn-edit"><i class="fas fa-pen"></i> @Localizer["Common_Edit"]</a>
                                    <button type="button" class="um-btn-sm um-btn-delete" onclick="showDeleteModal('@g.GradeId', 'this grade')"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<partial name="_DeleteModal" />
<partial name="_TableSearchScript" />
