@model IEnumerable<UM_Project.Models.ApplicationUser>
@using UM_Project.Models
@{
    ViewData["Title"] = "Users & Roles";
    ViewData["PageTitle"] = "Users & Roles";
    ViewData["PageIcon"] = "fa-users-cog";
    ViewData["PageSubtitle"] = "SuperAdmin only — manage all accounts, roles (including Admin), and passwords";
    ViewData["CreateController"] = "Users";
    ViewData["CreateText"] = "Add User";
    var userRoles = ViewBag.UserRoles as Dictionary<string, string>;
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar">
            <input type="text" id="searchInput" class="form-control" placeholder="Search by name, email, or role..." />
        </div>
        <div class="table-responsive">
            <table class="um-table" id="dataTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Verified</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var role = userRoles?.GetValueOrDefault(user.Id) ?? "No Role";
                        <tr>
                            <td class="fw-semibold">@user.FullName</td>
                            <td>@user.CustomId</td>
                            <td>@user.Email</td>
                            <td>
                                @switch (role)
                                {
                                    case RoleNames.SuperAdmin: <span class="um-badge um-badge-red">SuperAdmin</span> break;
                                    case RoleNames.Admin: <span class="um-badge um-badge-red">Admin</span> break;
                                    case RoleNames.Professor: <span class="um-badge um-badge-blue">Professor</span> break;
                                    case RoleNames.Student: <span class="um-badge um-badge-green">Student</span> break;
                                    case RoleNames.Parent: <span class="um-badge um-badge-orange">Parent</span> break;
                                    default: <span class="um-badge um-badge-gray">@role</span> break;
                                }
                            </td>
                            <td>
                                @if (user.EmailConfirmed) { <span class="um-badge um-badge-green">Yes</span> }
                                else { <span class="um-badge um-badge-gray">No</span> }
                            </td>
                            <td>
                                <div class="um-actions">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="um-btn-sm um-btn-edit"><i class="fas fa-pen"></i> Edit</a>
                                    @if (user.Email != "admin@umproject.com" && user.Email != "superadmin@umproject.com")
                                    {
                                        <button type="button" class="um-btn-sm um-btn-delete" onclick="showDeleteModal('@user.Id', '@user.FullName')"><i class="fas fa-trash"></i></button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<partial name="_DeleteModal" />
<partial name="_TableSearchScript" />
