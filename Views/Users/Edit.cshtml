@model UM_Project.Models.ApplicationUser
@{
    ViewData["Title"] = Localizer["Page_EditUser"];
    ViewData["FormTitle"] = Localizer["Page_EditUser"];
    ViewData["FormIcon"] = "fa-user-pen";
    ViewData["PageSubtitle"] = Localizer["Page_Users_Subtitle"];
    ViewData["ShowCreate"] = false;
    var roles = ViewBag.Roles as List<IdentityRole>;
    var currentRole = ViewBag.CurrentRole as string;
    var defaultPwd = ViewBag.DefaultPassword as string ?? "Welcome@123";
}

<div class="um-page">
    <partial name="_AdminFormHeader" />
    <div class="um-form-panel" style="max-width:720px">
        <div class="alert alert-info small mb-4">
            <i class="fas fa-shield-alt me-1"></i>
            @Localizer["Msg_SuperAdminRoleHint"]
        </div>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="CustomId" class="form-label"></label>
                <input asp-for="CustomId" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" required />
            </div>
            <div class="mb-4">
                <label class="form-label">@Localizer["Common_Role"]</label>
                <select name="role" class="form-select" required>
                    @if (roles != null)
                    {
                        foreach (var r in roles)
                        {
                            <option value="@r.Name" selected="@(r.Name == currentRole)">@r.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="um-btn-primary"><i class="fas fa-save"></i> @Localizer["Common_Save"]</button>
                <a asp-action="Index" class="btn btn-light border">@Localizer["Common_Cancel"]</a>
            </div>
        </form>
    </div>

    <div class="um-form-panel mt-4" style="max-width:720px">
        <h3 class="font-bold text-red-900 mb-3"><i class="fas fa-key me-2"></i>@Localizer["Label_ResetPassword"]</h3>
        <form asp-action="ResetPassword" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-md-6">
                <label class="form-label small">@Localizer.Format("Label_NewPasswordBlank", defaultPwd)</label>
                <input type="text" name="newPassword" class="form-control" />
            </div>
            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" name="requireChange" value="true" checked />
                    <label class="form-check-label small">@Localizer["Label_ForceChangeLogin"]</label>
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="um-btn-primary w-100 justify-content-center">@Localizer["Common_Reset"]</button>
            </div>
        </form>
    </div>
</div>
