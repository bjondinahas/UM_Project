@model UM_Project.Models.ApplicationUser

@{
    ViewData["Title"] = "Edit User";

    var roles = ViewBag.Roles as List<IdentityRole>;
    var currentRole = ViewBag.CurrentRole as string;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-warning text-white text-center py-3">
                    <h3 class="mb-0">
                        <i class="fas fa-user-edit me-2"></i>
                        Edit User
                    </h3>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Edit" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="Full Name"
                                   required />

                            <label asp-for="FullName">
                                Full Name
                            </label>

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="CustomId"
                                   class="form-control"
                                   placeholder="Custom ID"
                                   required />

                            <label asp-for="CustomId">
                                Custom ID
                            </label>

                            <span asp-validation-for="CustomId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Address"
                                   class="form-control"
                                   placeholder="Address" />

                            <label asp-for="Address">
                                Address
                            </label>

                            <span asp-validation-for="Address"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Email"
                                   required />

                            <label asp-for="Email">
                                Email
                            </label>

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-floating mb-3">

                            <select name="role"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Role --
                                </option>

                                @if (roles != null)
                                {
                                    foreach (var r in roles)
                                    {
                                        <option value="@r.Name"
                                                selected="@(r.Name == currentRole)">
                                            @r.Name
                                        </option>
                                    }
                                }

                            </select>

                            <label>
                                Role
                            </label>

                        </div>

                        <div class="d-grid gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">
                                <i class="fas fa-save me-2"></i>
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}