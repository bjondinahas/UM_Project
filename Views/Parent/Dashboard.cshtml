@model UM_Project.Models.ParentGuardian
@{
    ViewData["Title"] = Localizer["Nav_Dashboard"];
}

<div class="max-w-7xl mx-auto">
    <div class="mb-6 rounded-2xl bg-gradient-to-br from-red-900 via-red-700 to-red-500 p-6 text-white shadow-lg">
        <p class="text-sm opacity-80"><i class="fas fa-people-roof mr-1"></i> @Localizer["Dash_ParentPortal"]</p>
        <h1 class="text-2xl font-extrabold">@Localizer["Dash_Hello"] @Model.FullName</h1>
        <p class="mt-1 opacity-90">@Localizer["Dash_Child"] <strong>@ViewBag.StudentName</strong> (@ViewBag.StudentNumber) · @ViewBag.Department</p>
    </div>

    <partial name="_ParentChildSelector" />

    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
        <div class="rounded-2xl bg-white border border-red-100 p-4 shadow-sm text-center">
            <div class="text-2xl font-extrabold text-red-800">@ViewBag.AverageGrade</div>
            <div class="text-xs font-bold text-gray-500 uppercase">@Localizer["Dash_ChildAvgGrade"]</div>
        </div>
        <a asp-action="ChildGrades" asp-route-studentId="@ViewBag.SelectedStudentId" class="rounded-2xl bg-white border border-red-100 p-4 shadow-sm text-center hover:border-red-400 hover:shadow-md transition no-underline text-inherit">
            <div class="text-2xl font-extrabold text-red-800">@ViewBag.GradeCount</div>
            <div class="text-xs font-bold text-gray-500 uppercase">@Localizer["Dash_GradesCount"]</div>
        </a>
        <a asp-action="ChildSchedule" class="rounded-2xl bg-white border border-red-100 p-4 shadow-sm text-center hover:border-red-400 hover:shadow-md transition no-underline text-inherit">
            <div class="text-2xl font-extrabold text-red-800">@ViewBag.EnrollmentCount</div>
            <div class="text-xs font-bold text-gray-500 uppercase">@Localizer["Nav_Enrollments"]</div>
        </a>
        <div class="rounded-2xl bg-white border border-red-100 p-4 shadow-sm text-center">
            <div class="text-lg font-extrabold text-green-700">@ViewBag.PassedCourses <span class="text-red-600">/ @ViewBag.FailedCourses</span></div>
            <div class="text-xs font-bold text-gray-500 uppercase">@Localizer["Dash_PassFail"]</div>
        </div>
        <a asp-action="ChildAttendance" asp-route-studentId="@ViewBag.SelectedStudentId" class="rounded-2xl bg-white border border-amber-200 p-4 shadow-sm text-center hover:border-amber-400 no-underline text-inherit">
            <div class="text-2xl font-extrabold text-amber-800">@ViewBag.AbsencesThisMonth</div>
            <div class="text-xs font-bold text-gray-500 uppercase">@Localizer["Dash_AbsencesMonth"]</div>
        </a>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
        <div class="rounded-2xl border border-red-100 bg-white p-5 shadow-sm">
            <h3 class="font-bold text-red-900 mb-3"><i class="fas fa-chart-pie mr-2"></i>@Localizer["Dash_ChildGradeDist"]</h3>
            <div class="h-56 relative"><canvas id="parentGradeChart"></canvas></div>
        </div>
        <div class="rounded-2xl border border-red-100 bg-red-50/50 p-5">
            <h3 class="font-bold text-red-900 mb-3">@Localizer["Dash_QuickLinks"]</h3>
            <div class="space-y-3">
                <a asp-action="ChildGrades" asp-route-studentId="@ViewBag.SelectedStudentId" class="flex items-center gap-3 rounded-xl bg-white border border-red-100 p-4 font-semibold text-red-900 hover:bg-red-50 no-underline">
                    <i class="fas fa-star text-red-600 w-8 text-center"></i> @Localizer["Dash_ViewAllGrades"]
                </a>
                <a asp-action="ChildSchedule" asp-route-studentId="@ViewBag.SelectedStudentId" class="flex items-center gap-3 rounded-xl bg-white border border-red-100 p-4 font-semibold text-red-900 hover:bg-red-50 no-underline">
                    <i class="fas fa-calendar text-red-600 w-8 text-center"></i> @Localizer["Dash_ViewSchedule"]
                </a>
                <a asp-action="ChildAttendance" asp-route-studentId="@ViewBag.SelectedStudentId" class="flex items-center gap-3 rounded-xl bg-white border border-amber-200 p-4 font-semibold text-red-900 hover:bg-amber-50 no-underline">
                    <i class="fas fa-clipboard-check text-amber-600 w-8 text-center"></i> @Localizer["Dash_AttendanceCalendar"]
                </a>
                <a asp-action="ChildAssignments" asp-route-studentId="@ViewBag.SelectedStudentId" class="flex items-center gap-3 rounded-xl bg-white border border-red-100 p-4 font-semibold text-red-900 hover:bg-red-50 no-underline">
                    <i class="fas fa-tasks text-red-600 w-8 text-center"></i> @Localizer["Dash_AssignmentsDeadlines"]
                </a>
                <a asp-controller="DocumentRequests" asp-action="Index" class="flex items-center gap-3 rounded-xl bg-white border border-red-100 p-4 font-semibold text-red-900 hover:bg-red-50 no-underline">
                    <i class="fas fa-file-pdf text-red-600 w-8 text-center"></i> @Localizer["Dash_RequestTranscript"]
                </a>
            </div>
            <p class="text-xs text-gray-500 mt-4">@Localizer["Dash_OnlyLinkedChild"]</p>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/um-charts.js" asp-append-version="true"></script>
<script>
    UmCharts.create('parentGradeChart', {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.GradeLabels)),
            datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.GradeCounts)),
                backgroundColor: ['#7f1d1d','#dc2626','#ef4444','#fca5a5','#fecaca','#fee2e2'] }]
        },
        options: { cutout: '50%', aspectRatio: 1.4 }
    });
</script>
