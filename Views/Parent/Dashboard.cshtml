@model UM_Project.Models.ParentGuardian
@{
    ViewData["Title"] = Localizer["Nav_Dashboard"];
}

<div class="role-dash dash-shell">
    <header class="role-dash-header">
        <div>
            <p class="role-dash-eyebrow"><i class="fas fa-people-roof"></i> @Localizer["Dash_ParentPortal"]</p>
            <h1>@Localizer["Dash_Hello"] @Model.FullName</h1>
            <p class="dash-hero-sub mb-0">@Localizer["Dash_Child"] <strong>@ViewBag.StudentName</strong> (@ViewBag.StudentNumber) · @ViewBag.Department</p>
        </div>
    </header>

    <partial name="_ParentChildSelector" />

    <div class="parent-quick mb-3">
        <div class="parent-metric">
            <div class="pq-num">@ViewBag.AverageGrade</div>
            <div class="pq-lbl">@Localizer["Dash_ChildAvgGrade"]</div>
        </div>
        <a asp-action="ChildGrades" asp-route-studentId="@ViewBag.SelectedStudentId">
            <div class="pq-num">@ViewBag.GradeCount</div>
            <div class="pq-lbl">@Localizer["Dash_GradesCount"]</div>
        </a>
        <a asp-action="ChildSchedule" asp-route-studentId="@ViewBag.SelectedStudentId">
            <div class="pq-num">@ViewBag.EnrollmentCount</div>
            <div class="pq-lbl">@Localizer["Nav_Enrollments"]</div>
        </a>
        <div class="parent-metric">
            <div class="pq-num">@ViewBag.PassedCourses<span class="text-muted fw-normal"> / @ViewBag.FailedCourses</span></div>
            <div class="pq-lbl">@Localizer["Dash_PassFail"]</div>
        </div>
        <a asp-action="ChildAttendance" asp-route-studentId="@ViewBag.SelectedStudentId">
            <div class="pq-num">@ViewBag.AbsencesThisMonth</div>
            <div class="pq-lbl">@Localizer["Dash_AbsencesMonth"]</div>
        </a>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="dash-panel h-100">
                <div class="dash-panel__head"><i class="fas fa-chart-pie"></i> @Localizer["Dash_ChildGradeDist"]</div>
                <div class="dash-panel__body"><div class="dash-chart-h"><canvas id="parentGradeChart"></canvas></div></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="dash-panel h-100">
                <div class="dash-panel__head">@Localizer["Dash_QuickLinks"]</div>
                <div class="dash-panel__body">
                    <div class="dash-quick-links">
                        <a asp-action="ChildGrades" asp-route-studentId="@ViewBag.SelectedStudentId" class="dash-quick-link"><i class="fas fa-star"></i> @Localizer["Dash_ViewAllGrades"]</a>
                        <a asp-action="ChildSchedule" asp-route-studentId="@ViewBag.SelectedStudentId" class="dash-quick-link"><i class="fas fa-calendar"></i> @Localizer["Dash_ViewSchedule"]</a>
                        <a asp-action="ChildAttendance" asp-route-studentId="@ViewBag.SelectedStudentId" class="dash-quick-link"><i class="fas fa-clipboard-check"></i> @Localizer["Dash_AttendanceCalendar"]</a>
                        <a asp-action="ChildAssignments" asp-route-studentId="@ViewBag.SelectedStudentId" class="dash-quick-link"><i class="fas fa-tasks"></i> @Localizer["Dash_AssignmentsDeadlines"]</a>
                        <a asp-controller="DocumentRequests" asp-action="Index" class="dash-quick-link"><i class="fas fa-file-pdf"></i> @Localizer["Dash_RequestTranscript"]</a>
                    </div>
                    <p class="text-muted small mt-3 mb-0">@Localizer["Dash_OnlyLinkedChild"]</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/um-charts.js" asp-append-version="true"></script>
<script>
    UmCharts.create('parentGradeChart', {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.GradeLabels)),
            datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.GradeCounts)),
                backgroundColor: ['#1a1f36','#3b82f6','#60a5fa','#93c5fd','#22c55e','#86efac'] }]
        },
        options: { cutout: '50%', aspectRatio: 1.4 }
    });
</script>
