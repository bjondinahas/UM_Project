@model UM_Project.Models.ParentAttendanceCalendarViewModel
@{
    ViewData["Title"] = Localizer["Page_ChildAttendance"];
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
    var prev = Model.Month == 1 ? (Model.Year - 1, 12) : (Model.Year, Model.Month - 1);
    var next = Model.Month == 12 ? (Model.Year + 1, 1) : (Model.Year, Model.Month + 1);
}

<div class="max-w-7xl mx-auto">
    <div class="mb-4 flex flex-wrap justify-between items-center gap-3">
        <div>
            <a asp-action="Dashboard" asp-route-studentId="@Model.SelectedStudentId" class="text-sm font-semibold text-red-700 hover:underline"><i class="fas fa-arrow-left"></i> Dashboard</a>
            <h1 class="text-2xl font-extrabold text-red-900 mt-1">Attendance — @Model.Student.FullName</h1>
            <p class="text-gray-500 text-sm">@Model.Student.StudentNumber · @monthName</p>
        </div>
        <div class="flex gap-2">
            <a asp-action="ChildAttendance" asp-route-studentId="@Model.SelectedStudentId" asp-route-year="@prev.Item1" asp-route-month="@prev.Item2" class="btn btn-light border btn-sm">&laquo; Prev</a>
            <a asp-action="ChildAttendance" asp-route-studentId="@Model.SelectedStudentId" asp-route-year="@next.Item1" asp-route-month="@next.Item2" class="btn btn-light border btn-sm">Next &raquo;</a>
        </div>
    </div>

    @if (Model.LinkedChildren.Count > 1)
    {
        <form method="get" class="mb-4 d-flex gap-2 align-items-center">
            <label class="small fw-semibold">Child:</label>
            <select name="studentId" class="form-select form-select-sm" style="max-width:320px" onchange="this.form.submit()">
                @foreach (var c in Model.LinkedChildren)
                {
                    <option value="@c.StudentId" selected="@(c.StudentId == Model.SelectedStudentId)">@c.Student?.StudentNumber — @c.Student?.FullName</option>
                }
            </select>
            <input type="hidden" name="year" value="@Model.Year" />
            <input type="hidden" name="month" value="@Model.Month" />
        </form>
    }

    <div class="rounded-xl border border-red-100 bg-red-50/50 p-3 mb-4 text-sm">
        <strong>@Model.LessonSlots.Count lessons</strong> per school day:
        @string.Join(" · ", Model.LessonSlots.Select(s => $"{s.Title} ({s.StartTime}–{s.EndTime})"))
    </div>

    @if (!Model.Days.Any())
    {
        <div class="rounded-2xl border border-dashed border-red-200 p-8 text-center text-gray-600">
            No attendance recorded for this month yet.
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var day in Model.Days.OrderByDescending(d => d.Date))
            {
                <div class="rounded-2xl border border-red-100 bg-white p-4 shadow-sm">
                    <div class="flex flex-wrap justify-between items-center gap-2 mb-2">
                        <span class="font-bold text-red-900">@day.Date.ToString("dddd, dd MMM yyyy")</span>
                        <span class="rounded-full px-3 py-1 text-xs font-bold @(day.AbsentCount > 0 ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800")">
                            @(day.AbsentCount > 0 ? $"Missed {day.AbsentCount} of {day.TotalSlots} lessons" : "All lessons attended")
                        </span>
                    </div>
                    @if (day.Details.Any())
                    {
                        <ul class="mb-0 ps-3 small text-gray-700">
                            @foreach (var d in day.Details)
                            {
                                <li><strong>@d.LessonTitle</strong> (@d.TimeRange) — @d.CourseName</li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    }
</div>
