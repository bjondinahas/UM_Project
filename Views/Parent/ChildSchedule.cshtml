@model IEnumerable<UM_Project.Models.Schedule>
@{
    ViewData["Title"] = "Child's Schedule";
    ViewData["PageTitle"] = "Schedule";
    ViewData["PageIcon"] = "fa-calendar-alt";
    ViewData["PageSubtitle"] = ViewBag.StudentName as string;
    ViewData["ShowCreate"] = false;
}

<div class="um-page role-dash">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="table-responsive">
            <table class="um-table">
                <thead><tr><th>Course</th><th>Day</th><th>Time</th><th>Room</th></tr></thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No schedule found.</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.Course?.CourseName</td>
                            <td>@s.Day</td>
                            <td>@s.Time</td>
                            <td>@s.Room</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <a asp-action="Dashboard" class="um-btn-primary mt-3"><i class="fas fa-arrow-left"></i> Dashboard</a>
</div>
