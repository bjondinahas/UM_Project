@model IEnumerable<UM_Project.Models.Grade>
@{
    ViewData["Title"] = Localizer["Page_ChildGrades"];
    ViewData["PageTitle"] = Localizer["Nav_Grades"];
    ViewData["PageIcon"] = "fa-star";
    ViewData["PageSubtitle"] = ViewBag.StudentName as string;
    ViewData["ShowCreate"] = false;
}

<div class="um-page role-dash">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="table-responsive">
            <table class="um-table">
                <thead><tr><th>@Localizer["Label_Course"]</th><th>@Localizer["Table_Grade"]</th><th>Date</th></tr></thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="3" class="text-center text-muted py-4">@Localizer["Msg_NoGradesYet"]</td></tr>
                    }
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@g.Course?.CourseName</td>
                            <td><span class="um-badge @(g.Value >= (ViewBag.GradePassingMin ?? 3) ? "um-badge-green" : "um-badge-red")">@g.Value</span></td>
                            <td>@g.DateRecorded.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <a asp-action="Dashboard" class="um-btn-primary mt-3"><i class="fas fa-arrow-left"></i> Dashboard</a>
</div>
