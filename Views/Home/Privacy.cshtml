@{
    ViewData["Title"] = Localizer["Pub_Privacy_Title"];
}

<section class="pub-hero pub-page min-h-[32vh] flex items-center"
         style="background-image: url('https://images.unsplash.com/photo-1450101499163-c8848c66ca85?w=1920&q=80');">
    <div class="pub-hero-overlay w-full py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
            <i class="fas fa-shield-halved text-4xl mb-4 opacity-90"></i>
            <h1 class="text-4xl font-extrabold">@Localizer["Pub_Privacy_Title"]</h1>
            <p class="mt-4 text-red-100 max-w-xl mx-auto">@Localizer["Pub_Privacy_Intro"]</p>
        </div>
    </div>
</section>

<section class="pub-section bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-10">
            <div>
                <h2 class="text-xl font-bold text-brand-800 flex items-center gap-2">
                    <i class="fas fa-database text-brand-600"></i> @Localizer["Pub_Privacy_S1"]
                </h2>
                <p class="mt-3 text-gray-600 leading-relaxed">@Localizer["Pub_Privacy_S1Desc"]</p>
            </div>
            <div>
                <h2 class="text-xl font-bold text-brand-800 flex items-center gap-2">
                    <i class="fas fa-gears text-brand-600"></i> @Localizer["Pub_Privacy_S2"]
                </h2>
                <p class="mt-3 text-gray-600 leading-relaxed">@Localizer["Pub_Privacy_S2Desc"]</p>
            </div>
            <div>
                <h2 class="text-xl font-bold text-brand-800 flex items-center gap-2">
                    <i class="fas fa-lock text-brand-600"></i> @Localizer["Pub_Privacy_S3"]
                </h2>
                <p class="mt-3 text-gray-600 leading-relaxed">@Localizer["Pub_Privacy_S3Desc"]</p>
            </div>
        </div>
        <div class="mt-12 text-center">
            <a asp-controller="Home" asp-action="Index"
               class="inline-flex items-center gap-2 text-brand-700 font-semibold hover:text-brand-600">
                <i class="fas fa-arrow-left"></i> @Localizer["Pub_BackHome"]
            </a>
        </div>
    </div>
</section>
