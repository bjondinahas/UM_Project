@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #011425, #1F4959); border-radius: 20px 20px 0 0;">
                    <i class="fas fa-shield-alt fa-3x mb-2"></i>
                    <h2 class="mb-0">Privacy Policy</h2>
                </div>
                <div class="card-body p-5">
                    <h4>Information We Collect</h4>
                    <p>We collect personal information such as name, email address, and academic records for educational purposes.</p>
                    <h4 class="mt-4">How We Use Your Information</h4>
                    <p>Your information is used to manage academic records, grades, and course enrollments within the university system.</p>
                    <h4 class="mt-4">Data Security</h4>
                    <p>We implement appropriate security measures to protect your personal information from unauthorized access.</p>
                    <h4 class="mt-4">Contact Us</h4>
                    <p>If you have any questions about this privacy policy, please contact the university administration.</p>
                </div>
                <div class="card-footer text-center py-3 bg-light">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>
