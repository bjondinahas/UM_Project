@{
    ViewData["Title"] = Localizer["Pub_Contact_Title"];
}

<section class="pub-hero pub-page min-h-[36vh] flex items-center"
         style="background-image: url('https://images.unsplash.com/photo-1423666639041-f56000c27a9a?w=1920&q=80');">
    <div class="pub-hero-overlay w-full py-16 lg:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
            <h1 class="text-4xl sm:text-5xl font-extrabold">@Localizer["Pub_Contact_Title"]</h1>
            <p class="mt-4 text-lg text-red-100 max-w-xl mx-auto">@Localizer["Pub_Contact_Subtitle"]</p>
        </div>
    </div>
</section>

<section class="pub-section bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12">
            <div class="space-y-6">
                <div class="bg-white rounded-2xl border border-red-100 p-6 shadow-sm flex gap-4">
                    <span class="h-12 w-12 rounded-xl bg-brand-600 text-white flex items-center justify-center shrink-0"><i class="fas fa-envelope"></i></span>
                    <div>
                        <h3 class="font-bold text-gray-900">@Localizer["Pub_Contact_Email"]</h3>
                        <a href="mailto:support@universitymanager.edu" class="text-brand-600 hover:underline">support@universitymanager.edu</a>
                    </div>
                </div>
                <div class="bg-white rounded-2xl border border-red-100 p-6 shadow-sm flex gap-4">
                    <span class="h-12 w-12 rounded-xl bg-brand-600 text-white flex items-center justify-center shrink-0"><i class="fas fa-phone"></i></span>
                    <div>
                        <h3 class="font-bold text-gray-900">@Localizer["Pub_Contact_Phone"]</h3>
                        <p class="text-gray-600">+355 4 000 0000</p>
                    </div>
                </div>
                <div class="bg-white rounded-2xl border border-red-100 p-6 shadow-sm flex gap-4">
                    <span class="h-12 w-12 rounded-xl bg-brand-600 text-white flex items-center justify-center shrink-0"><i class="fas fa-clock"></i></span>
                    <div>
                        <h3 class="font-bold text-gray-900">@Localizer["Pub_Contact_Hours"]</h3>
                        <p class="text-gray-600">@Localizer["Pub_Contact_HoursVal"]</p>
                    </div>
                </div>
                <div class="rounded-2xl overflow-hidden shadow-lg hidden sm:block">
                    <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&q=80"
                         alt="" class="w-full h-48 object-cover" loading="lazy" />
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-red-100 shadow-xl p-8">
                <form id="contact-form" class="space-y-5">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">@Localizer["Pub_Contact_Name"]</label>
                        <input type="text" id="contact-name" required
                               class="w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">@Localizer["Pub_Contact_Email"]</label>
                        <input type="email" id="contact-email" required
                               class="w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">@Localizer["Pub_Contact_Message"]</label>
                        <textarea id="contact-message" rows="5" required
                                  class="w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none resize-none"></textarea>
                    </div>
                    <p class="text-xs text-gray-500">@Localizer["Pub_Contact_Note"]</p>
                    <button type="submit" class="w-full home-nav-btn home-nav-btn--primary py-3 text-base">
                        <i class="fas fa-paper-plane"></i> @Localizer["Pub_Contact_Send"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('contact-form')?.addEventListener('submit', function (e) {
            e.preventDefault();
            var name = document.getElementById('contact-name').value;
            var email = document.getElementById('contact-email').value;
            var msg = document.getElementById('contact-message').value;
            var subject = encodeURIComponent('University Manager — Contact');
            var body = encodeURIComponent('From: ' + name + ' (' + email + ')\n\n' + msg);
            window.location.href = 'mailto:support@universitymanager.edu?subject=' + subject + '&body=' + body;
        });
    </script>
}
