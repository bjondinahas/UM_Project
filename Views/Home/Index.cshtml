@{
    ViewData["Title"] = "Welcome";
}
<div class="container py-5">
    <div class="text-center">
        <i class="fas fa-graduation-cap fa-5x mb-4" style="color: #1F4959;"></i>
        <h1 class="display-3 fw-bold" style="color: #011425;">Welcome to University Manager</h1>
        <p class="lead text-muted mt-3">The Complete Student Management System</p>
        <hr class="my-4" style="width: 80px; margin: 20px auto; border-color: #1F4959;">
        @if (!User.Identity.IsAuthenticated)
        {
            <div class="mt-5">
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg px-5 py-3">
                    <i class="fas fa-sign-in-alt me-2"></i> Login to System
                </a>
            </div>
        }
    </div>
</div>
