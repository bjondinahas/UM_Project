@model IEnumerable<UM_Project.Models.AuthAuditLog>
@{
    ViewData["Title"] = Localizer["Nav_LoginActivity"];
    ViewData["PageTitle"] = Localizer["Nav_LoginActivity"];
    ViewData["PageIcon"] = "fa-clock-rotate-left";
    ViewData["PageSubtitle"] = Localizer["Admin_AuthSubtitle"];
    ViewData["ShowCreate"] = false;
}

<div class="um-page">
    <partial name="_AdminPageHeader" />

    <div class="um-panel mb-4">
        <div class="um-panel-toolbar">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">@Localizer["Common_Event"]</label>
                    <select name="eventType" class="form-select">
                        <option value="">@Localizer["Common_All"]</option>
                        @foreach (var et in (IEnumerable<string>)ViewBag.EventTypes)
                        {
                            <option value="@et" selected="@(ViewBag.CurrentEventType as string == et)">@et</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">@Localizer["Analytics_Status"]</label>
                    <select name="success" class="form-select">
                        <option value="">@Localizer["Common_All"]</option>
                        <option value="true" selected="@(ViewBag.CurrentSuccess as bool? == true)">@Localizer["Common_Success"]</option>
                        <option value="false" selected="@(ViewBag.CurrentSuccess as bool? == false)">@Localizer["Common_Failed"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="um-btn-primary w-100 justify-content-center"><i class="fas fa-filter"></i> @Localizer["Common_Search"]</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="AuthLogs" class="btn btn-light w-100 border">@Localizer["Common_Reset"]</a>
                </div>
            </form>
        </div>
    </div>

    <div class="um-panel">
        <div class="table-responsive">
            <table class="um-table">
                <thead>
                    <tr><th>Time (UTC)</th><th>Event</th><th>Email</th><th>Status</th><th>Location</th><th>IP</th><th>Details</th></tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No records found.</td></tr>
                    }
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-nowrap small">@log.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="um-badge um-badge-gray">@log.EventType</span></td>
                            <td>@(log.Email ?? "—")</td>
                            <td>
                                @if (log.Success) { <span class="um-badge um-badge-green">OK</span> }
                                else { <span class="um-badge um-badge-red">Failed</span> }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(log.City) || !string.IsNullOrEmpty(log.Country))
                                { <span>@log.City@(!string.IsNullOrEmpty(log.City) && !string.IsNullOrEmpty(log.Country) ? ", " : "")@log.Country</span> }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="small font-mono">@(log.IpAddress ?? "—")</td>
                            <td class="small text-muted">@(log.FailureReason ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (ViewBag.TotalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
                <span class="small text-muted">@ViewBag.TotalLogs records · Page @ViewBag.Page of @ViewBag.TotalPages</span>
                <div class="btn-group btn-group-sm">
                    @if (ViewBag.Page > 1)
                    {
                        <a asp-action="AuthLogs" asp-route-page="@((int)ViewBag.Page - 1)" asp-route-eventType="@ViewBag.CurrentEventType" asp-route-success="@ViewBag.CurrentSuccess" class="btn btn-outline-danger">Prev</a>
                    }
                    @if (ViewBag.Page < ViewBag.TotalPages)
                    {
                        <a asp-action="AuthLogs" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-eventType="@ViewBag.CurrentEventType" asp-route-success="@ViewBag.CurrentSuccess" class="btn btn-outline-danger">Next</a>
                    }
                </div>
            </div>
        }
    </div>
</div>
