@{
    ViewData["Title"] = "Admin Dashboard";
}
<style>
    .stat-card { background: white; border-radius: 20px; padding: 20px; text-align: center; transition: all 0.3s; cursor: pointer; box-shadow: 0 5px 15px rgba(0,0,0,0.08); }
    .stat-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.12); }
    .stat-number { font-size: 2rem; font-weight: bold; color: #1F4959; }
    .quick-action { background: linear-gradient(135deg, #1F4959, #5C7C89); color: white; border-radius: 12px; padding: 15px; margin-bottom: 15px; cursor: pointer; transition: all 0.3s; }
    .quick-action:hover { transform: translateX(5px); background: linear-gradient(135deg, #011425, #1F4959); }
    .welcome-banner { 
        background: linear-gradient(135deg, #011425, #1F4959); 
        border-radius: 24px; 
        padding: 30px; 
        color: white; 
        margin-top: 25px; 
        margin-bottom: 30px; 
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        border: 1px solid rgba(255,255,255,0.1);
    }
    .stats-row { display: flex; flex-wrap: wrap; gap: 15px; margin-bottom: 25px; }
    .stats-card { flex: 1; min-width: 150px; background: white; border-radius: 20px; padding: 15px; text-align: center; box-shadow: 0 5px 10px rgba(0,0,0,0.05); }
    .stats-number { font-size: 2.2rem; font-weight: bold; color: #1F4959; }
    .stats-label { color: #666; font-size: 0.9rem; }
    .percentage-badge { font-size: 1rem; background: #e9ecef; padding: 4px 10px; border-radius: 20px; display: inline-block; margin-top: 5px; }
</style>

<div class="container-fluid">
  
    <div class="welcome-banner">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold">Welcome back, Admin!</h1>
                <p class="lead">Here's what's happening with your system today.</p>
                <div class="mt-3">
                    <span class="badge bg-light text-dark me-2"><i class="fas fa-calendar"></i> @DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
                    <span class="badge bg-light text-dark"><i class="fas fa-clock"></i> @DateTime.Now.ToString("hh:mm tt")</span>
                </div>
            </div>
            <div class="col-md-4 text-center"><i class="fas fa-chart-line fa-4x opacity-50"></i></div>
        </div>
    </div>


    <div class="row mb-4">
        <div class="col-md-2 col-6 mb-3"><div class="stat-card" onclick="location.href='@Url.Action("Index", "Users")'"><i class="fas fa-users fa-2x"></i><div class="stat-number">@ViewBag.TotalUsers</div><div>Users</div></div></div>
        <div class="col-md-2 col-6 mb-3"><div class="stat-card" onclick="location.href='@Url.Action("Index", "Departments")'"><i class="fas fa-building fa-2x"></i><div class="stat-number">@ViewBag.TotalDepartments</div><div>Departments</div></div></div>
        <div class="col-md-2 col-6 mb-3"><div class="stat-card" onclick="location.href='@Url.Action("Index", "Courses")'"><i class="fas fa-book fa-2x"></i><div class="stat-number">@ViewBag.TotalCourses</div><div>Courses</div></div></div>
        <div class="col-md-2 col-6 mb-3"><div class="stat-card" onclick="location.href='@Url.Action("Index", "Professors")'"><i class="fas fa-chalkboard-teacher fa-2x"></i><div class="stat-number">@ViewBag.TotalProfessors</div><div>Professors</div></div></div>
        <div class="col-md-2 col-6 mb-3"><div class="stat-card" onclick="location.href='@Url.Action("Index", "Students")'"><i class="fas fa-user-graduate fa-2x"></i><div class="stat-number">@ViewBag.TotalStudents</div><div>Students</div></div></div>
        <div class="col-md-2 col-6 mb-3"><div class="stat-card" onclick="location.href='@Url.Action("Index", "Enrollments")'"><i class="fas fa-registered fa-2x"></i><div class="stat-number">@ViewBag.TotalEnrollments</div><div>Enrollments</div></div></div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3"><div class="stat-card" onclick="location.href='@Url.Action("Index", "Grades")'"><i class="fas fa-star fa-2x"></i><div class="stat-number">@ViewBag.TotalGrades</div><div>Grades</div></div></div>
        <div class="col-md-3"><div class="stat-card" onclick="location.href='@Url.Action("Index", "Statistics")'"><i class="fas fa-chart-line fa-2x"></i><div class="stat-number">@ViewBag.AverageGrade</div><div>Average Grade</div></div></div>
        <div class="col-md-3"><div class="stat-card" onclick="location.href='@Url.Action("Index", "Schedules")'"><i class="fas fa-calendar-alt fa-2x"></i><div class="stat-number">📅</div><div>Schedules</div></div></div>
    </div>

    <!-- Student Performance Overview -->
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header" style="background: linear-gradient(135deg, #011425, #1F4959); color: white;">
                    <i class="fas fa-chart-simple me-2"></i> Student Performance Overview
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-6">
                            <div class="stats-card">
                                <div class="stats-number">@ViewBag.PassingCount</div>
                                <div class="stats-label">Students Passing (Grade ≥ 6)</div>
                                <div class="percentage-badge bg-success text-white">@ViewBag.PassingPercentage %</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="stats-card">
                                <div class="stats-number">@ViewBag.FailingCount</div>
                                <div class="stats-label">Students Failing (Grade = 5)</div>
                                <div class="percentage-badge bg-danger text-white">@ViewBag.FailingPercentage %</div>
                            </div>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height: 30px;">
                        <div class="progress-bar bg-success" style="width: @ViewBag.PassingPercentage%">Passing @ViewBag.PassingPercentage%</div>
                        <div class="progress-bar bg-danger" style="width: @ViewBag.FailingPercentage%">Failing @ViewBag.FailingPercentage%</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions dhe System Status -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header" style="background: linear-gradient(135deg, #011425, #1F4959); color: white;">
                    <i class="fas fa-bolt me-2"></i> Quick Actions
                </div>
                <div class="card-body">
                    <div class="quick-action" onclick="location.href='@Url.Action("Create", "Students")'"><i class="fas fa-user-plus me-2"></i> Add New Student</div>
                    <div class="quick-action" onclick="location.href='@Url.Action("Create", "Professors")'"><i class="fas fa-chalkboard-teacher me-2"></i> Add New Professor</div>
                    <div class="quick-action" onclick="location.href='@Url.Action("Create", "Courses")'"><i class="fas fa-book me-2"></i> Add New Course</div>
                    <div class="quick-action" onclick="location.href='@Url.Action("Create", "Enrollments")'"><i class="fas fa-registered me-2"></i> New Enrollment</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header" style="background: linear-gradient(135deg, #011425, #1F4959); color: white;">
                    <i class="fas fa-chart-line me-2"></i> System Status
                </div>
                <div class="card-body">
                    <div class="mb-3"><div class="d-flex justify-content-between"><span>Database Connection</span><span class="text-success"><i class="fas fa-check-circle"></i> Connected</span></div><div class="progress mt-1" style="height:5px"><div class="progress-bar bg-success" style="width:100%"></div></div></div>
                    <div class="alert alert-info mt-3 mb-0"><i class="fas fa-info-circle me-2"></i>Last backup: @DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row mt-4">
        <div class="col-md-6"><div class="card"><div class="card-header" style="background: linear-gradient(135deg, #011425, #1F4959); color: white;"><i class="fas fa-chart-pie me-2"></i> Grade Distribution</div><div class="card-body"><canvas id="gradeChart" style="height:300px"></canvas></div></div></div>
        <div class="col-md-6"><div class="card"><div class="card-header" style="background: linear-gradient(135deg, #011425, #1F4959); color: white;"><i class="fas fa-chart-bar me-2"></i> Passing vs Failing (Bar)</div><div class="card-body"><canvas id="passingChart" style="height:300px"></canvas></div></div></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    new Chart(document.getElementById('gradeChart'), {
        type: 'doughnut',
        data: { labels: ['10','9','8','7','6','5'], datasets: [{ data: [@ViewBag.Grade10, @ViewBag.Grade9, @ViewBag.Grade8, @ViewBag.Grade7, @ViewBag.Grade6, @ViewBag.Grade5], backgroundColor: ['#2ecc71','#27ae60','#f39c12','#e67e22','#e74c3c','#c0392b'] }] }
    });
    new Chart(document.getElementById('passingChart'), {
        type: 'bar',
        data: { labels: ['Passing (6-10)', 'Failing (5)'], datasets: [{ label: 'Students', data: [@ViewBag.PassingCount, @ViewBag.FailingCount], backgroundColor: ['#27ae60','#e74c3c'] }] }
    });
</script>
