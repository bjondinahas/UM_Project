@{
    var title = ViewData["FormTitle"]?.ToString() ?? ViewData["Title"]?.ToString() ?? Localizer["Common_Form"];
    var icon = ViewData["FormIcon"]?.ToString() ?? "fa-pen-to-square";
    var backController = ViewData["BackController"]?.ToString() ?? ViewContext.RouteData.Values["controller"]?.ToString();
    var backAction = ViewData["BackAction"]?.ToString() ?? "Index";
}

<div class="um-page-header">
    <div>
        <h1><i class="fas @icon"></i> @title</h1>
        <p class="um-page-subtitle">
            <a asp-controller="@backController" asp-action="@backAction" class="text-danger text-decoration-none fw-semibold">
                <i class="fas fa-arrow-left me-1"></i> @Localizer["Msg_BackToList"]
            </a>
        </p>
    </div>
</div>
