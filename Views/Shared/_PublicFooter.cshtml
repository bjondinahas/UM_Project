<footer class="home-footer">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
            <div>
                <a asp-controller="Home" asp-action="Index" class="home-footer-brand">
                    <img src="~/images/logo.png" alt="UM Project" class="home-footer-brand-logo" height="32" />
                    <span>@Localizer["App_Title"]</span>
                </a>
                <p class="home-footer-tagline mt-4">@Localizer["Footer_Tagline"]</p>
            </div>
            <div>
                <h4 class="home-footer-heading">@Localizer["Footer_Explore"]</h4>
                <ul class="home-footer-links">
                    <li><a asp-controller="Home" asp-action="Index">@Localizer["Nav_Home"]</a></li>
                    <li><a asp-controller="Home" asp-action="Features">@Localizer["Home_Features"]</a></li>
                    <li><a asp-controller="Home" asp-action="About">@Localizer["Home_About"]</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="roles">@Localizer["Nav_Roles"]</a></li>
                </ul>
            </div>
            <div>
                <h4 class="home-footer-heading">@Localizer["Footer_Support"]</h4>
                <ul class="home-footer-links">
                    <li><a asp-controller="Home" asp-action="Contact">@Localizer["Nav_Contact"]</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">@Localizer["Nav_Privacy"]</a></li>
                    <li><a asp-area="Identity" asp-page="/Account/Login">@Localizer["Auth_Login"]</a></li>
                    <li><a asp-area="Identity" asp-page="/Account/Register">@Localizer["Auth_Register"]</a></li>
                </ul>
            </div>
            <div>
                <h4 class="home-footer-heading">@Localizer["Footer_Connect"]</h4>
                <p class="home-footer-contact-item"><i class="fas fa-envelope"></i> support@universitymanager.edu</p>
                <p class="home-footer-contact-item"><i class="fas fa-phone"></i> +355 4 000 0000</p>
                <div class="home-footer-social mt-4">
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
        </div>
        <div class="home-footer-bottom">
            <p>&copy; @DateTime.Now.Year @Localizer["Footer_Copyright"]</p>
        </div>
    </div>
</footer>
