@model ErrorViewModel
@{
    ViewData["Title"] = Localizer["Common_Error"];
}

<h1 class="text-danger">@Localizer["Common_Error"]</h1>
<h2 class="text-danger">@Localizer["Error_RequestFailed"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["Error_RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<p class="text-muted">@Localizer["Msg_ErrorContactAdmin"]</p>
