@{
    var children = ViewBag.Children as List<UM_Project.Models.ParentGuardian>;
    var selectedId = ViewBag.SelectedStudentId as int?;
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
@if (children != null && children.Count > 1)
{
    <form method="get" class="mb-4 flex flex-wrap gap-2 items-center">
        <label class="text-sm font-semibold text-red-900">@Localizer["Parent_ViewingChild"]</label>
        <select name="studentId" class="form-select form-select-sm" style="max-width:360px" onchange="this.form.submit()">
            @foreach (var c in children)
            {
                <option value="@c.StudentId" selected="@(c.StudentId == selectedId)">@c.Student?.StudentNumber — @c.Student?.FullName</option>
            }
        </select>
    </form>
}
