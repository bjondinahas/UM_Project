@{
    ViewData["Title"] = "Statistics";
}

<style>
    .stat-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        text-align: center;
        transition: all 0.3s;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    }
    .stat-number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #1F4959;
    }
    .stat-label {
        color: #666;
        margin-top: 10px;
        font-size: 0.9rem;
    }
    .average-card {
        background: linear-gradient(135deg, #1F4959, #5C7C89);
        color: white;
        border-radius: 20px;
        padding: 30px;
        text-align: center;
    }
    .average-number {
        font-size: 4rem;
        font-weight: bold;
    }
    .average-label {
        font-size: 1.2rem;
        opacity: 0.9;
    }
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-chart-line me-2"></i>System Statistics</h1>
    </div>

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="stat-card">
                <i class="fas fa-user-graduate fa-2x" style="color: #1F4959;"></i>
                <div class="stat-number">@ViewBag.TotalStudents</div>
                <div class="stat-label">Total Students</div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="stat-card">
                <i class="fas fa-chalkboard-teacher fa-2x" style="color: #1F4959;"></i>
                <div class="stat-number">@ViewBag.TotalProfessors</div>
                <div class="stat-label">Total Professors</div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="stat-card">
                <i class="fas fa-book fa-2x" style="color: #1F4959;"></i>
                <div class="stat-number">@ViewBag.TotalCourses</div>
                <div class="stat-label">Total Courses</div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="stat-card">
                <i class="fas fa-building fa-2x" style="color: #1F4959;"></i>
                <div class="stat-number">@ViewBag.TotalDepartments</div>
                <div class="stat-label">Total Departments</div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <i class="fas fa-registered fa-2x" style="color: #1F4959;"></i>
                <div class="stat-number">@ViewBag.TotalEnrollments</div>
                <div class="stat-label">Total Enrollments</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <i class="fas fa-star fa-2x" style="color: #1F4959;"></i>
                <div class="stat-number">@ViewBag.TotalGrades</div>
                <div class="stat-label">Total Grades</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="average-card">
                <div class="average-number">@ViewBag.AverageGrade</div>
                <div class="average-label">Average Grade</div>
                <small class="mt-2 d-block">(Scale: 5-10)</small>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 text-center">
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
    </div>
</div>
