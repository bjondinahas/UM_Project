@model UM_Project.Models.AnalyticsViewModel
@{
    ViewData["Title"] = Localizer["Nav_Analytics"];
    var f = Model.Filter;
    var chartPassing = Localizer["Chart_Passing"];
    var chartFailing = Localizer["Chart_Failing"];
}

<div class="analytics-page um-page">
    <div class="analytics-header">
        <div>
            <h1>@Localizer["Nav_Analytics"]</h1>
            <p>@Localizer["Analytics_Subtitle"]</p>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="analytics-back">
            <i class="fas fa-arrow-left"></i> @Localizer["Nav_Dashboard"]
        </a>
    </div>

    <form method="get" class="analytics-filters">
        <div class="analytics-filters-head">
            <h2><i class="fas fa-filter"></i>@Localizer["Dash_Filters"]</h2>
            <a asp-action="Index" class="analytics-clear">@Localizer["Analytics_ClearAll"]</a>
        </div>
        <div class="um-filter-grid">
            <div>
                <label class="um-select-label">@Localizer["Reports_DepartmentLabel"]</label>
                <select name="departmentId" class="form-select um-select w-100">
                    <option value="">@Localizer["Analytics_AllDepartments"]</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(f.DepartmentId == d.DepartmentId)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div>
                <label class="um-select-label">@Localizer["Reports_Course"]</label>
                <select name="courseId" class="form-select um-select w-100">
                    <option value="">@Localizer["Analytics_AllCourses"]</option>
                    @foreach (var c in Model.Courses)
                    {
                        <option value="@c.CourseId" selected="@(f.CourseId == c.CourseId)">@c.CourseCode — @c.CourseName</option>
                    }
                </select>
            </div>
            <div>
                <label class="um-select-label">@Localizer["Table_Professor"]</label>
                <select name="professorId" class="form-select um-select w-100">
                    <option value="">@Localizer["Analytics_AllProfessors"]</option>
                    @foreach (var p in Model.Professors)
                    {
                        <option value="@p.ProfessorId" selected="@(f.ProfessorId == p.ProfessorId)">@p.FullName</option>
                    }
                </select>
            </div>
            <div>
                <label class="um-select-label">@Localizer["Table_Grade"]</label>
                <select name="gradeValue" class="form-select um-select w-100">
                    <option value="">@Localizer["Analytics_AnyGrade"]</option>
                    @for (int i = Model.GradeMaximum; i >= Model.GradeMinimum; i--)
                    {
                        <option value="@i" selected="@(f.GradeValue == i)">@i</option>
                    }
                </select>
            </div>
            <div>
                <label class="um-select-label">@Localizer["Analytics_Status"]</label>
                <select name="status" class="form-select um-select w-100">
                    <option value="">@Localizer["Common_All"]</option>
                    <option value="pass" selected="@(f.Status == "pass")">@Localizer["Analytics_PassOnly"]</option>
                    <option value="fail" selected="@(f.Status == "fail")">@Localizer["Analytics_FailOnly"]</option>
                </select>
            </div>
            <div>
                <label class="um-select-label">@Localizer["Reports_From"]</label>
                <input type="date" name="dateFrom" value="@(f.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div>
                <label class="um-select-label">@Localizer["Reports_To"]</label>
                <input type="date" name="dateTo" value="@(f.DateTo?.Date.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div>
                <label class="um-select-label">@Localizer["Common_Search"]</label>
                <input type="text" name="search" value="@f.Search" placeholder="@Localizer["Analytics_SearchPlaceholder"]" class="form-control" />
            </div>
        </div>
        <button type="submit" class="analytics-apply">
            <i class="fas fa-search"></i> @Localizer["Analytics_ApplyFilters"]
        </button>
        @if (f.DepartmentId != null || f.CourseId != null || f.ProfessorId != null || f.GradeValue != null || !string.IsNullOrEmpty(f.Status) || f.DateFrom != null || f.DateTo != null || !string.IsNullOrEmpty(f.Search))
        {
            <p class="analytics-filter-note"><i class="fas fa-circle-info"></i> @Localizer["Analytics_FilteredNote"]</p>
        }
    </form>

    <div class="analytics-kpis">
        <div class="analytics-kpi analytics-kpi--hero">
            <div class="analytics-kpi-value">@Model.AverageGrade</div>
            <div class="analytics-kpi-label">@Localizer["Analytics_AvgGradeFiltered"]</div>
        </div>
        <div class="analytics-kpi">
            <div class="analytics-kpi-value">@Model.TotalStudents</div>
            <div class="analytics-kpi-label">@Localizer["Nav_Students"]</div>
        </div>
        <div class="analytics-kpi">
            <div class="analytics-kpi-value">@Model.TotalGrades</div>
            <div class="analytics-kpi-label">@Localizer["Analytics_TotalGrades"]</div>
        </div>
        <div class="analytics-kpi analytics-kpi--pass">
            <div class="analytics-kpi-value">@Model.PassingStudents</div>
            <div class="analytics-kpi-label">@Localizer["Chart_Passing"]</div>
        </div>
        <div class="analytics-kpi analytics-kpi--fail">
            <div class="analytics-kpi-value">@Model.FailingStudents</div>
            <div class="analytics-kpi-label">@Localizer["Chart_Failing"]</div>
        </div>
    </div>

    <div class="analytics-charts">
        <div class="analytics-chart-card">
            <h3><i class="fas fa-chart-pie"></i>@Localizer["Dash_GradeDistribution"]</h3>
            <div class="analytics-chart-wrap"><canvas id="gradeChart"></canvas></div>
        </div>
        <div class="analytics-chart-card">
            <h3><i class="fas fa-chart-bar"></i>@Localizer["Dash_PassVsFail"]</h3>
            <div class="analytics-chart-wrap"><canvas id="passingChart"></canvas></div>
        </div>
        <div class="analytics-chart-card">
            <h3><i class="fas fa-building"></i>@Localizer["Dash_StudentsByDept"]</h3>
            <div class="analytics-chart-wrap"><canvas id="deptChart"></canvas></div>
        </div>
        <div class="analytics-chart-card">
            <h3><i class="fas fa-book"></i>@Localizer["Analytics_GradesPerCourse"]</h3>
            <div class="analytics-chart-wrap"><canvas id="courseChart"></canvas></div>
        </div>
    </div>

    <div class="analytics-table-card">
        <div class="analytics-table-head">
            <h3><i class="fas fa-table me-2"></i>@Localizer["Analytics_GradeRecords"] (@Model.GradeRows.Count)</h3>
            <input type="text" id="gradeTableSearch" class="form-control form-control-sm" placeholder="@Localizer["Analytics_SearchTable"]" />
        </div>
        <div class="table-responsive" style="max-height: 400px;">
            <table class="um-table mb-0" id="gradeTable">
                <thead class="sticky-top">
                    <tr>
                        <th>@Localizer["Table_Student"]</th>
                        <th>@Localizer["Table_StudentNum"]</th>
                        <th>@Localizer["Table_Course"]</th>
                        <th>@Localizer["Table_Dept"]</th>
                        <th>@Localizer["Table_Professor"]</th>
                        <th>@Localizer["Table_Grade"]</th>
                        <th>@Localizer["Table_Status"]</th>
                        <th>@Localizer["Table_Date"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.GradeRows.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">@Localizer["Analytics_NoGradesMatch"]</td></tr>
                    }
                    @foreach (var row in Model.GradeRows)
                    {
                        <tr>
                            <td class="fw-semibold">@row.StudentName</td>
                            <td>@row.StudentNumber</td>
                            <td>@row.CourseName</td>
                            <td>@row.DepartmentName</td>
                            <td>@row.ProfessorName</td>
                            <td><span class="um-badge @(row.Value >= Model.GradePassingMinimum ? "um-badge-green" : "um-badge-red")">@row.Value</span></td>
                            <td>@row.Status</td>
                            <td class="small">@row.DateRecorded.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="analytics-table-card">
        <div class="analytics-table-head">
            <h3><i class="fas fa-user-graduate me-2"></i>@Localizer["Nav_Students"] (@Model.StudentRows.Count)</h3>
            <input type="text" id="studentTableSearch" class="form-control form-control-sm" placeholder="@Localizer["Analytics_SearchStudents"]" />
        </div>
        <div class="table-responsive" style="max-height: 340px;">
            <table class="um-table mb-0" id="studentTable">
                <thead class="sticky-top">
                    <tr>
                        <th>@Localizer["Table_Name"]</th>
                        <th>@Localizer["Table_StudentNum"]</th>
                        <th>@Localizer["Table_Email"]</th>
                        <th>@Localizer["Reports_DepartmentLabel"]</th>
                        <th>@Localizer["Table_Enrollments"]</th>
                        <th>@Localizer["Table_AvgGrade"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.StudentRows)
                    {
                        <tr>
                            <td class="fw-semibold">@s.FullName</td>
                            <td>@s.StudentNumber</td>
                            <td class="small">@s.Email</td>
                            <td>@s.DepartmentName</td>
                            <td>@s.EnrollmentCount</td>
                            <td>@(s.AverageGrade?.ToString("0.00") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/um-charts.js" asp-append-version="true"></script>
<script>
    const navy = '#1a1f36', blue = '#3b82f6', blueLight = '#93c5fd', green = '#22c55e';
    UmCharts.create('gradeChart', {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GradeHistogramLabels)),
            datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GradeHistogram)),
                backgroundColor: [navy, blue, '#60a5fa', blueLight, '#bfdbfe', '#e2e8f0'], borderWidth: 0 }]
        },
        options: { cutout: '58%', plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } } }
    });
    UmCharts.create('passingChart', {
        type: 'bar',
        data: {
            labels: [@Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartPassing)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartFailing))],
            datasets: [{ data: [@Model.PassingStudents, @Model.FailingStudents], backgroundColor: [green, blue], borderRadius: 8, maxBarThickness: 56 }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
    });
    UmCharts.create('deptChart', {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeptLabels)),
            datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeptCounts)), backgroundColor: blue, borderRadius: 6 }]
        },
        options: { indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, ticks: { precision: 0 } } } }
    });
    UmCharts.create('courseChart', {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CourseLabels)),
            datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CourseCounts)), backgroundColor: navy, borderRadius: 6 }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
    });
    function tableFilter(inputId, tableId) {
        const input = document.getElementById(inputId);
        const table = document.getElementById(tableId);
        if (!input || !table) return;
        input.addEventListener('keyup', function () {
            const q = this.value.toLowerCase();
            table.querySelectorAll('tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    }
    tableFilter('gradeTableSearch', 'gradeTable');
    tableFilter('studentTableSearch', 'studentTable');
</script>
