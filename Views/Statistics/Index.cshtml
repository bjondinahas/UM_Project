@model UM_Project.Models.AnalyticsViewModel
@{
    ViewData["Title"] = Localizer["Nav_Analytics"];
    var f = Model.Filter;
    var chartPassing = Localizer["Chart_Passing"];
    var chartFailing = Localizer["Chart_Failing"];
}

<div class="max-w-7xl mx-auto px-1 pb-8">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-extrabold text-red-900 flex items-center gap-2">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-red-600 to-red-800 text-white">
                    <i class="fas fa-chart-line"></i>
                </span>
                @Localizer["Nav_Analytics"]
            </h1>
            <p class="text-gray-500 mt-1 ml-14">@Localizer["Analytics_Subtitle"]</p>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="inline-flex items-center gap-2 rounded-xl border border-red-200 bg-white px-4 py-2 text-sm font-semibold text-red-800 hover:bg-red-50">
            <i class="fas fa-arrow-left"></i> @Localizer["Nav_Dashboard"]
        </a>
    </div>

    <!-- Filters -->
    <form method="get" class="rounded-2xl border border-red-100 bg-white p-5 shadow-sm mb-6">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
            <h2 class="font-bold text-red-900"><i class="fas fa-filter me-2"></i>@Localizer["Dash_Filters"]</h2>
            <a asp-action="Index" class="text-sm font-semibold text-red-700 hover:underline">@Localizer["Analytics_ClearAll"]</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">@Localizer["Reports_DepartmentLabel"]</label>
                <select name="departmentId" class="form-select rounded-lg border-red-100 text-sm w-full">
                    <option value="">@Localizer["Analytics_AllDepartments"]</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(f.DepartmentId == d.DepartmentId)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">@Localizer["Reports_Course"]</label>
                <select name="courseId" class="form-select rounded-lg border-red-100 text-sm w-full">
                    <option value="">@Localizer["Analytics_AllCourses"]</option>
                    @foreach (var c in Model.Courses)
                    {
                        <option value="@c.CourseId" selected="@(f.CourseId == c.CourseId)">@c.CourseCode — @c.CourseName</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">@Localizer["Table_Professor"]</label>
                <select name="professorId" class="form-select rounded-lg border-red-100 text-sm w-full">
                    <option value="">@Localizer["Analytics_AllProfessors"]</option>
                    @foreach (var p in Model.Professors)
                    {
                        <option value="@p.ProfessorId" selected="@(f.ProfessorId == p.ProfessorId)">@p.FullName</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">@Localizer["Table_Grade"]</label>
                <select name="gradeValue" class="form-select rounded-lg border-red-100 text-sm w-full">
                    <option value="">@Localizer["Analytics_AnyGrade"]</option>
                    @for (int i = 10; i >= 5; i--)
                    {
                        <option value="@i" selected="@(f.GradeValue == i)">@i</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">@Localizer["Analytics_Status"]</label>
                <select name="status" class="form-select rounded-lg border-red-100 text-sm w-full">
                    <option value="">@Localizer["Common_All"]</option>
                    <option value="pass" selected="@(f.Status == "pass")">@Localizer["Analytics_PassOnly"]</option>
                    <option value="fail" selected="@(f.Status == "fail")">@Localizer["Analytics_FailOnly"]</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">@Localizer["Reports_From"]</label>
                <input type="date" name="dateFrom" value="@(f.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control rounded-lg border-red-100 text-sm" />
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">@Localizer["Reports_To"]</label>
                <input type="date" name="dateTo" value="@(f.DateTo?.Date.ToString("yyyy-MM-dd"))" class="form-control rounded-lg border-red-100 text-sm" />
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">@Localizer["Common_Search"]</label>
                <input type="text" name="search" value="@f.Search" placeholder="@Localizer["Analytics_SearchPlaceholder"]" class="form-control rounded-lg border-red-100 text-sm" />
            </div>
        </div>
        <div class="mt-4 flex gap-2">
            <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-red-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-red-700">
                <i class="fas fa-search"></i> @Localizer["Analytics_ApplyFilters"]
            </button>
        </div>
        @if (f.DepartmentId != null || f.CourseId != null || f.ProfessorId != null || f.GradeValue != null || !string.IsNullOrEmpty(f.Status) || f.DateFrom != null || f.DateTo != null || !string.IsNullOrEmpty(f.Search))
        {
            <p class="text-xs text-gray-500 mt-3 mb-0"><i class="fas fa-info-circle me-1"></i>@Localizer["Analytics_FilteredNote"]</p>
        }
    </form>

    <!-- KPIs -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-6">
        <div class="rounded-2xl bg-gradient-to-br from-red-800 to-red-600 p-4 text-white shadow-lg col-span-2 lg:col-span-1">
            <div class="text-3xl font-extrabold">@Model.AverageGrade</div>
            <div class="text-xs opacity-80">@Localizer["Analytics_AvgGradeFiltered"]</div>
        </div>
        <div class="rounded-xl border border-red-100 bg-white p-3 text-center shadow-sm">
            <div class="text-xl font-extrabold text-red-800">@Model.TotalStudents</div>
            <div class="text-[10px] font-bold text-gray-500 uppercase">@Localizer["Nav_Students"]</div>
        </div>
        <div class="rounded-xl border border-red-100 bg-white p-3 text-center shadow-sm">
            <div class="text-xl font-extrabold text-red-800">@Model.TotalGrades</div>
            <div class="text-[10px] font-bold text-gray-500 uppercase">@Localizer["Analytics_TotalGrades"]</div>
        </div>
        <div class="rounded-xl border border-red-100 bg-white p-3 text-center shadow-sm">
            <div class="text-xl font-extrabold text-green-700">@Model.PassingStudents</div>
            <div class="text-[10px] font-bold text-gray-500 uppercase">@Localizer["Chart_Passing"]</div>
        </div>
        <div class="rounded-xl border border-red-100 bg-white p-3 text-center shadow-sm">
            <div class="text-xl font-extrabold text-red-700">@Model.FailingStudents</div>
            <div class="text-[10px] font-bold text-gray-500 uppercase">@Localizer["Chart_Failing"]</div>
        </div>
    </div>

    <!-- Charts -->
    <div class="grid lg:grid-cols-2 gap-6 mb-6">
        <div class="rounded-2xl border border-red-100 bg-white p-5 shadow-sm">
            <h3 class="font-bold text-red-900 mb-3"><i class="fas fa-chart-pie me-2"></i>@Localizer["Dash_GradeDistribution"]</h3>
            <div class="h-56 relative"><canvas id="gradeChart"></canvas></div>
        </div>
        <div class="rounded-2xl border border-red-100 bg-white p-5 shadow-sm">
            <h3 class="font-bold text-red-900 mb-3"><i class="fas fa-chart-bar me-2"></i>@Localizer["Dash_PassVsFail"]</h3>
            <div class="h-56 relative"><canvas id="passingChart"></canvas></div>
        </div>
        <div class="rounded-2xl border border-red-100 bg-white p-5 shadow-sm">
            <h3 class="font-bold text-red-900 mb-3"><i class="fas fa-building me-2"></i>@Localizer["Dash_StudentsByDept"]</h3>
            <div class="h-56 relative"><canvas id="deptChart"></canvas></div>
        </div>
        <div class="rounded-2xl border border-red-100 bg-white p-5 shadow-sm">
            <h3 class="font-bold text-red-900 mb-3"><i class="fas fa-book me-2"></i>@Localizer["Analytics_GradesPerCourse"]</h3>
            <div class="h-56 relative"><canvas id="courseChart"></canvas></div>
        </div>
    </div>

    <!-- Grade records table -->
    <div class="rounded-2xl border border-red-100 bg-white shadow-sm mb-6 overflow-hidden">
        <div class="p-4 border-b border-red-50 flex flex-wrap justify-between items-center gap-3 bg-red-50/30">
            <h3 class="font-bold text-red-900 mb-0"><i class="fas fa-table me-2"></i>@Localizer["Analytics_GradeRecords"] (@Model.GradeRows.Count)</h3>
            <input type="text" id="gradeTableSearch" class="form-control form-control-sm rounded-lg" style="max-width:280px" placeholder="@Localizer["Analytics_SearchTable"]" />
        </div>
        <div class="table-responsive max-h-96 overflow-y-auto">
            <table class="um-table mb-0" id="gradeTable">
                <thead class="sticky top-0">
                    <tr>
                        <th>@Localizer["Table_Student"]</th><th>@Localizer["Table_StudentNum"]</th><th>@Localizer["Table_Course"]</th><th>@Localizer["Table_Dept"]</th><th>@Localizer["Table_Professor"]</th><th>@Localizer["Table_Grade"]</th><th>@Localizer["Table_Status"]</th><th>@Localizer["Table_Date"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.GradeRows.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">@Localizer["Analytics_NoGradesMatch"]</td></tr>
                    }
                    @foreach (var row in Model.GradeRows)
                    {
                        <tr>
                            <td class="fw-semibold">@row.StudentName</td>
                            <td>@row.StudentNumber</td>
                            <td>@row.CourseName</td>
                            <td>@row.DepartmentName</td>
                            <td>@row.ProfessorName</td>
                            <td><span class="um-badge @(row.Value >= 6 ? "um-badge-green" : "um-badge-red")">@row.Value</span></td>
                            <td>@row.Status</td>
                            <td class="small">@row.DateRecorded.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Students table -->
    <div class="rounded-2xl border border-red-100 bg-white shadow-sm overflow-hidden">
        <div class="p-4 border-b border-red-50 flex flex-wrap justify-between items-center gap-3 bg-red-50/30">
            <h3 class="font-bold text-red-900 mb-0"><i class="fas fa-user-graduate me-2"></i>@Localizer["Nav_Students"] (@Model.StudentRows.Count)</h3>
            <input type="text" id="studentTableSearch" class="form-control form-control-sm rounded-lg" style="max-width:280px" placeholder="@Localizer["Analytics_SearchStudents"]" />
        </div>
        <div class="table-responsive max-h-80 overflow-y-auto">
            <table class="um-table mb-0" id="studentTable">
                <thead class="sticky top-0">
                    <tr><th>@Localizer["Table_Name"]</th><th>@Localizer["Table_StudentNum"]</th><th>@Localizer["Table_Email"]</th><th>@Localizer["Reports_DepartmentLabel"]</th><th>@Localizer["Table_Enrollments"]</th><th>@Localizer["Table_AvgGrade"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.StudentRows)
                    {
                        <tr>
                            <td class="fw-semibold">@s.FullName</td>
                            <td>@s.StudentNumber</td>
                            <td class="small">@s.Email</td>
                            <td>@s.DepartmentName</td>
                            <td>@s.EnrollmentCount</td>
                            <td>@(s.AverageGrade?.ToString("0.00") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/um-charts.js" asp-append-version="true"></script>
<script>
    const red = '#dc2626', redDark = '#991b1b', redLight = '#fca5a5';
    UmCharts.create('gradeChart', {
        type: 'doughnut',
        data: {
            labels: ['10','9','8','7','6','5'],
            datasets: [{ data: [@Model.Grade10,@Model.Grade9,@Model.Grade8,@Model.Grade7,@Model.Grade6,@Model.Grade5],
                backgroundColor: [redDark, red, '#ef4444', redLight, '#fecaca', '#fee2e2'], borderWidth: 0 }]
        },
        options: { cutout: '55%', aspectRatio: 1.4 }
    });
    UmCharts.create('passingChart', {
        type: 'bar',
        data: {
            labels: [@Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartPassing)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartFailing))],
            datasets: [{ data: [@Model.PassingStudents, @Model.FailingStudents], backgroundColor: [red, redDark], borderRadius: 8 }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }, aspectRatio: 1.6 }
    });
    UmCharts.create('deptChart', {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeptLabels)),
            datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeptCounts)), backgroundColor: red, borderRadius: 6 }]
        },
        options: { indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }, aspectRatio: 1.2 }
    });
    UmCharts.create('courseChart', {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CourseLabels)),
            datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CourseCounts)), backgroundColor: redDark, borderRadius: 6 }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }, aspectRatio: 1.3 }
    });

    function tableFilter(inputId, tableId) {
        const input = document.getElementById(inputId);
        const table = document.getElementById(tableId);
        if (!input || !table) return;
        input.addEventListener('keyup', function () {
            const q = this.value.toLowerCase();
            table.querySelectorAll('tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    }
    tableFilter('gradeTableSearch', 'gradeTable');
    tableFilter('studentTableSearch', 'studentTable');
</script>
