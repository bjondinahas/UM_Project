@model UM_Project.Models.Schedule
@{
    ViewData["Title"] = Localizer["Page_CreateSchedule"];
    ViewData["FormTitle"] = Localizer["Page_CreateSchedule"];
    ViewData["FormIcon"] = "fa-calendar-plus";
    var courses = ViewBag.Courses as List<UM_Project.Models.Course>;
}

<div class="um-page">
    <partial name="_AdminFormHeader" />
    <div class="um-form-panel">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="CourseId" class="form-label">@Localizer["Label_Course"]</label>
                <select asp-for="CourseId" class="form-select" required>
                    <option value="">@Localizer["Form_SelectCourse"]</option>
                    @if (courses != null) { foreach (var c in courses) { <option value="@c.CourseId">@c.CourseName (@c.CourseCode)</option> } }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Day" class="form-label"></label>
                <input asp-for="Day" class="form-control" placeholder="@Localizer["Placeholder_Monday"]" required />
            </div>
            <div class="mb-3">
                <label asp-for="Time" class="form-label"></label>
                <input asp-for="Time" class="form-control" placeholder="09:00 – 10:30" required />
            </div>
            <div class="mb-4">
                <label asp-for="Room" class="form-label"></label>
                <input asp-for="Room" class="form-control" placeholder="@Localizer["Placeholder_Room"]" required />
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="um-btn-primary"><i class="fas fa-save"></i> @Localizer["Common_Save"]</button>
                <a asp-action="Index" class="btn btn-light border">@Localizer["Common_Cancel"]</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
