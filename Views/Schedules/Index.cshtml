@model IEnumerable<UM_Project.Models.Schedule>
@{
    ViewData["Title"] = Localizer["Nav_Schedules"];
    ViewData["PageTitle"] = Localizer["Nav_Schedules"];
    ViewData["PageIcon"] = "fa-calendar-alt";
    ViewData["PageSubtitle"] = Localizer["Page_Schedules_Subtitle"];
    ViewData["CreateController"] = "Schedules";
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar">
            <input type="text" id="searchInput" class="form-control" placeholder="@Localizer["Search_Schedules"]" />
        </div>
        <div class="table-responsive">
            <table class="um-table" id="dataTable">
                <thead>
                    <tr><th>@Localizer["Label_Course"]</th><th>Day</th><th>Time</th><th>Room</th><th>@Localizer["Common_Actions"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@(s.Course?.CourseName ?? "—")</td>
                            <td>@s.Day</td>
                            <td>@s.Time</td>
                            <td>@s.Room</td>
                            <td>
                                <div class="um-actions">
                                    <a asp-action="Edit" asp-route-id="@s.ScheduleId" class="um-btn-sm um-btn-edit"><i class="fas fa-pen"></i> @Localizer["Common_Edit"]</a>
                                    <button type="button" class="um-btn-sm um-btn-delete" onclick="showDeleteModal('@s.ScheduleId', 'this schedule')"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<partial name="_DeleteModal" />
<partial name="_TableSearchScript" />
