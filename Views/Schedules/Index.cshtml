@model IEnumerable<UM_Project.Models.Schedule>
@{
    ViewData["Title"] = "Lecture Schedules";
}

<style>
    .btn-xs {
        padding: 0.2rem 0.5rem;
        font-size: 0.7rem;
        border-radius: 0.2rem;
    }
    .table td, .table th {
        vertical-align: middle;
    }
    .action-btns {
        display: flex;
        gap: 6px;
    }
</style>

<div class="container-fluid mt-4">
    <div class="d-flex align-items-center mb-4">
        <a href="/Admin/Dashboard" class="back-arrow" style="font-size:1.5rem;color:#1F4959;margin-right:10px;"><i class="fas fa-arrow-left"></i></a>
        <h1><i class="fas fa-calendar-alt"></i> Schedules</h1>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="card shadow-sm">
        <div class="card-body">
            <input type="text" id="searchInput" class="form-control" placeholder="Search by course, day, room..." />
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="dataTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Course</th>
                            <th>Day</th>
                            <th>Time</th>
                            <th>Room</th>
                            <th style="width: 120px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@(s.Course?.CourseName ?? "N/A")</td>
                                <td>@s.Day</td>
                                <td>@s.Time</td>
                                <td>@s.Room</td>
                                <td>
                                    <div class="action-btns">
                                        <a asp-action="Edit" asp-route-id="@s.ScheduleId" class="btn btn-info btn-xs">Edit</a>
                                        <button type="button" class="btn btn-secondary btn-xs" onclick="showDeleteModal('@s.ScheduleId', 'schedule for @(s.Course?.CourseName ?? "course")')">Delete</button>
                                    </div>
                                 </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-end">
            <a asp-action="Create" class="btn btn-primary">+ Create New</a>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="deleteItemName"></strong>?</p>
                <p class="text-danger">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="DeleteConfirmed">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteItemId" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('searchInput').addEventListener('keyup', function() {
        var filter = this.value.toLowerCase();
        var rows = document.querySelectorAll('#dataTable tbody tr');
        rows.forEach(row => {
            var text = row.textContent.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    });
    function showDeleteModal(id, name) {
        document.getElementById('deleteItemId').value = id;
        document.getElementById('deleteItemName').innerText = name;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }
</script>
