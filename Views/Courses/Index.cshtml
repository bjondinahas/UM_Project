@model IEnumerable<UM_Project.Models.Course>
@{
    ViewData["Title"] = Localizer["Nav_Courses"];
    ViewData["PageTitle"] = Localizer["Nav_Courses"];
    ViewData["PageIcon"] = "fa-book";
    ViewData["PageSubtitle"] = Localizer["Page_Courses_Subtitle"];
    ViewData["CreateController"] = "Courses";
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar">
            <div class="um-search-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" class="form-control" placeholder="@Localizer["Search_Courses"]" />
            </div>
        </div>
        <div class="table-responsive">
            <table class="um-table" id="dataTable">
                <thead>
                    <tr><th>@Localizer["Table_Code"]</th><th>@Localizer["Table_Name"]</th><th>@Localizer["Table_Semester"]</th><th>@Localizer["Table_Credits"]</th><th>@Localizer["Table_Docs"]</th><th>@Localizer["Nav_Departments"]</th><th>@Localizer["Table_Professor"]</th><th>@Localizer["Common_Actions"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="um-badge um-badge-gray">@c.CourseCode</span></td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@c.CourseId" class="text-danger text-decoration-none">@c.CourseName</a>
                            </td>
                            <td>@(c.Semester ?? "—")</td>
                            <td>@c.Credits</td>
                            <td>@(c.Documents?.Count ?? 0)</td>
                            <td>@(c.Department?.DepartmentName ?? "—")</td>
                            <td>@(c.Professor?.FullName ?? "—")</td>
                            <td>
                                <div class="um-actions">
                                    <a asp-action="Details" asp-route-id="@c.CourseId" class="um-btn-sm um-btn-edit" title="@Localizer["Title_Details"]"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@c.CourseId" class="um-btn-sm um-btn-edit"><i class="fas fa-pen"></i></a>
                                    <button type="button" class="um-btn-sm um-btn-delete" onclick="showDeleteModal('@c.CourseId', '@c.CourseName')"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<partial name="_DeleteModal" />
<partial name="_TableSearchScript" />
