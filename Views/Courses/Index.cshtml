@model IEnumerable<UM_Project.Models.Course>
@{
    ViewData["Title"] = "Courses";
    ViewData["PageTitle"] = "Courses";
    ViewData["PageIcon"] = "fa-book";
    ViewData["PageSubtitle"] = "Course catalog, credits, and professor assignments";
    ViewData["CreateController"] = "Courses";
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar">
            <input type="text" id="searchInput" class="form-control" placeholder="Search code, name, department..." />
        </div>
        <div class="table-responsive">
            <table class="um-table" id="dataTable">
                <thead>
                    <tr><th>Code</th><th>Name</th><th>Semester</th><th>Credits</th><th>Docs</th><th>Department</th><th>Professor</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="um-badge um-badge-gray">@c.CourseCode</span></td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@c.CourseId" class="text-danger text-decoration-none">@c.CourseName</a>
                            </td>
                            <td>@(c.Semester ?? "—")</td>
                            <td>@c.Credits</td>
                            <td>@(c.Documents?.Count ?? 0)</td>
                            <td>@(c.Department?.DepartmentName ?? "—")</td>
                            <td>@(c.Professor?.FullName ?? "—")</td>
                            <td>
                                <div class="um-actions">
                                    <a asp-action="Details" asp-route-id="@c.CourseId" class="um-btn-sm um-btn-edit" title="Details"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@c.CourseId" class="um-btn-sm um-btn-edit"><i class="fas fa-pen"></i></a>
                                    <button type="button" class="um-btn-sm um-btn-delete" onclick="showDeleteModal('@c.CourseId', '@c.CourseName')"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<partial name="_DeleteModal" />
<partial name="_TableSearchScript" />
