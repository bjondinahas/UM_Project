@model UM_Project.Models.Department
@{
    ViewData["Title"] = "Edit Department";
    ViewData["FormTitle"] = "Edit Department";
    ViewData["FormIcon"] = "fa-pen";
}

<div class="um-page">
    <partial name="_AdminFormHeader" />
    <div class="um-form-panel">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="DepartmentId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-4">
                <label asp-for="DepartmentName" class="form-label"></label>
                <input asp-for="DepartmentName" class="form-control" required />
                <span asp-validation-for="DepartmentName" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="um-btn-primary"><i class="fas fa-save"></i> Save Changes</button>
                <a asp-action="Index" class="btn btn-light border">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
