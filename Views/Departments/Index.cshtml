@model IEnumerable<UM_Project.Models.Department>
@{
    ViewData["Title"] = "Departments";
    ViewData["PageTitle"] = "Departments";
    ViewData["PageIcon"] = "fa-building";
    ViewData["PageSubtitle"] = "Organize academic departments";
    ViewData["CreateController"] = "Departments";
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar">
            <input type="text" id="searchInput" class="form-control" placeholder="Search departments..." />
        </div>
        <div class="table-responsive">
            <table class="um-table" id="dataTable">
                <thead><tr><th>Department Name</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@d.DepartmentName</td>
                            <td>
                                <div class="um-actions">
                                    <a asp-action="Edit" asp-route-id="@d.DepartmentId" class="um-btn-sm um-btn-edit"><i class="fas fa-pen"></i> Edit</a>
                                    <button type="button" class="um-btn-sm um-btn-delete" onclick="showDeleteModal('@d.DepartmentId', '@d.DepartmentName')"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<partial name="_DeleteModal" />
<partial name="_TableSearchScript" />
