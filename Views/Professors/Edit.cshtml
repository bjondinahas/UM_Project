@model UM_Project.Models.Professor
@{
    ViewData["Title"] = Localizer["Page_EditProfessor"];
    ViewData["FormTitle"] = Localizer["Page_EditProfessor"];
    ViewData["FormIcon"] = "fa-pen";
    var departments = ViewBag.Departments as List<UM_Project.Models.Department>;
}

<div class="um-page">
    <partial name="_AdminFormHeader" />
    <div class="um-form-panel" style="max-width:720px">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ProfessorId" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="UserId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="rounded-xl border border-gray-200 bg-gray-50 p-3 mb-4 text-sm">
                <p class="mb-0"><strong>@Localizer["Label_LoginEmail"]</strong> @Model.Email</p>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="DepartmentId" class="form-label">@Localizer["Label_Department"]</label>
                    <select asp-for="DepartmentId" class="form-select" required>
                        @if (departments != null) { foreach (var d in departments) { <option value="@d.DepartmentId">@d.DepartmentName</option> } }
                    </select>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap mt-4">
                <button type="submit" class="um-btn-primary"><i class="fas fa-save"></i> @Localizer["Common_Save"]</button>
                <a asp-action="Index" class="btn btn-light border">@Localizer["Common_Cancel"]</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
