@model UM_Project.Models.Professor
@{
    ViewData["Title"] = Localizer["Page_CreateProfessor"];
    ViewData["FormTitle"] = Localizer["Page_CreateProfessor"];
    ViewData["FormIcon"] = "fa-chalkboard-teacher";
    var departments = ViewBag.Departments as List<UM_Project.Models.Department>;
}

<div class="um-page">
    <partial name="_AdminFormHeader" />
    <div class="um-form-panel" style="max-width:720px">
        <div class="rounded-xl border border-blue-100 bg-blue-50/80 p-4 mb-4 text-sm text-blue-900">
            <p class="font-bold mb-2"><i class="fas fa-magic me-1"></i> @Localizer["Msg_AutoAccountSetup"]</p>
            <ul class="mb-0 ps-3 space-y-1">
                <li><strong>@Localizer["Label_StaffId"]</strong> — @Localizer["Msg_StaffIdAuto"]</li>
                <li>@Localizer["Msg_ProfCreateEmail"] <code>@@shkollademo.edu</code></li>
                <li>@Localizer["Msg_ProfCreatePwd"]</li>
            </ul>
        </div>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label">@Localizer["Form_FullName"]</label>
                    <input asp-for="FullName" class="form-control" placeholder="@Localizer["Placeholder_FullName"]" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">@Localizer["Label_Title"]</label>
                    <input asp-for="Title" class="form-control" placeholder="@Localizer["Placeholder_ProfessorTitle"]" />
                </div>
                <div class="col-12">
                    <label asp-for="DepartmentId" class="form-label">@Localizer["Label_Department"]</label>
                    <select asp-for="DepartmentId" class="form-select" required>
                        <option value="">@Localizer["Form_SelectDepartment"]</option>
                        @if (departments != null) { foreach (var d in departments) { <option value="@d.DepartmentId">@d.DepartmentName</option> } }
                    </select>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap mt-4">
                <button type="submit" class="um-btn-primary"><i class="fas fa-user-plus"></i> Create professor & login</button>
                <a asp-action="Index" class="btn btn-light border">@Localizer["Common_Cancel"]</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
