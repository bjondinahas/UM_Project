@model IEnumerable<UM_Project.Models.Professor>
@{
    ViewData["Title"] = "Professors";
    ViewData["PageTitle"] = "Professors";
    ViewData["PageIcon"] = "fa-chalkboard-teacher";
    ViewData["PageSubtitle"] = "Faculty members and department assignments";
    ViewData["CreateController"] = "Professors";
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar">
            <input type="text" id="searchInput" class="form-control" placeholder="Search name, email, title..." />
        </div>
        <div class="table-responsive">
            <table class="um-table" id="dataTable">
                <thead>
                    <tr><th>Name</th><th>Email</th><th>Title</th><th>Department</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@p.FullName</td>
                            <td>@p.Email</td>
                            <td>@(string.IsNullOrEmpty(p.Title) ? "Professor" : p.Title)</td>
                            <td>@(p.Department?.DepartmentName ?? "—")</td>
                            <td>
                                <div class="um-actions">
                                    <a asp-action="Edit" asp-route-id="@p.ProfessorId" class="um-btn-sm um-btn-edit"><i class="fas fa-pen"></i></a>
                                    <form asp-action="ResetPassword" method="post" class="d-inline" onsubmit="return confirm('Reset to default password?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="professorId" value="@p.ProfessorId" />
                                        <button type="submit" class="um-btn-sm um-btn-edit" title="Reset password"><i class="fas fa-key"></i></button>
                                    </form>
                                    <button type="button" class="um-btn-sm um-btn-delete" onclick="showDeleteModal('@p.ProfessorId', '@p.FullName')"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<partial name="_DeleteModal" />
<partial name="_TableSearchScript" />
