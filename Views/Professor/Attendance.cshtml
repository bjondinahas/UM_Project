@model UM_Project.Models.ProfessorAttendanceViewModel
@{
    ViewData["Title"] = Localizer["Nav_Attendance"];
    ViewData["PageTitle"] = $"{Localizer["Nav_Attendance"]} — {Model.Course.CourseCode}";
    ViewData["PageIcon"] = "fa-clipboard-check";
    ViewData["PageSubtitle"] = Model.Course.CourseName;
    ViewData["ShowCreate"] = false;
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    @{
        var allowed = ViewBag.AttendanceAllowed as bool? ?? true;
        var blockReason = ViewBag.BlockReason as string;
    }
    @if (!allowed)
    {
        <div class="alert alert-warning mb-4"><i class="fas fa-ban me-2"></i><strong>@Localizer["Msg_AttendanceBlocked"]</strong> @(blockReason ?? Localizer["Msg_NonSchoolDay"])</div>
    }
    else
    {
        <div class="rounded-xl border border-blue-100 bg-blue-50/80 p-3 mb-4 text-sm">
            @Localizer.Format("Msg_AttendanceHelp", Model.LessonSlots.Count)
        </div>
    }

    <form method="get" class="d-flex flex-wrap gap-2 mb-4 align-items-end">
        <div>
            <label class="form-label small">@Localizer["Label_Date"]</label>
            <input type="date" name="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" />
        </div>
        <input type="hidden" name="id" value="@Model.Course.CourseId" />
        <button type="submit" class="um-btn-sm um-btn-edit">@Localizer["Btn_LoadDay"]</button>
    </form>

    @if (!Model.Students.Any())
    {
        <p class="text-muted">@Localizer["Msg_NoStudentsCourse"]</p>
    }
    else if (allowed)
    {
        <form asp-action="SaveAttendance" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="courseId" value="@Model.Course.CourseId" />
            <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
            <div class="table-responsive um-panel p-0">
                <table class="um-table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>@Localizer["Table_Student"]</th>
                            @foreach (var slot in Model.LessonSlots)
                            {
                                <th class="text-center" style="min-width:90px">
                                    <div class="small fw-bold">@slot.Title</div>
                                    <div class="text-muted" style="font-size:0.65rem">@slot.StartTime–@slot.EndTime</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var st in Model.Students)
                        {
                            <tr>
                                <td>
                                    <span class="um-badge um-badge-gray me-1">@st.StudentNumber</span>
                                    <span class="fw-semibold">@st.FullName</span>
                                </td>
                                @foreach (var slot in Model.LessonSlots)
                                {
                                    var key = $"{st.StudentId}:{slot.LessonSlotId}";
                                    var isAbsent = Model.AbsentKeys.Contains(key);
                                    <td class="text-center">
                                        <label class="d-inline-flex flex-column align-items-center gap-0 m-0" title="@Localizer["Label_Absent"]">
                                            <input type="checkbox" name="absent" value="@key" class="form-check-input" @(isAbsent ? "checked" : "") />
                                            <span class="text-muted" style="font-size:0.6rem">@Localizer["Label_Missed"]</span>
                                        </label>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="um-btn-primary"><i class="fas fa-save"></i> @Localizer["Label_SaveAttendance"]</button>
                <a asp-action="Dashboard" class="btn btn-light border">@Localizer["Nav_Dashboard"]</a>
            </div>
        </form>
    }
</div>
