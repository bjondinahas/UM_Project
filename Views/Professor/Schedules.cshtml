@model IEnumerable<UM_Project.Models.Schedule>
@{
    ViewData["Title"] = "My Schedules";
    ViewData["PageTitle"] = "My Course Schedules";
    ViewData["PageIcon"] = "fa-calendar-alt";
    ViewData["ShowCreate"] = false;
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    @if (!Model.Any())
    {
        <div class="role-empty"><i class="fas fa-calendar d-block"></i><p class="mb-0">No schedules assigned to your courses yet.</p></div>
    }
    else
    {
        <div class="um-panel">
            <div class="table-responsive">
                <table class="um-table">
                    <thead><tr><th>Course</th><th>Day</th><th>Time</th><th>Room</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@s.Course?.CourseName</td>
                                <td>@s.Day</td>
                                <td>@s.Time</td>
                                <td>@s.Room</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    <a asp-action="Dashboard" class="um-btn-primary mt-3"><i class="fas fa-arrow-left"></i> Dashboard</a>
</div>
