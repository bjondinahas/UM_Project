@model IEnumerable<UM_Project.Models.Schedule>
@{
    ViewData["Title"] = "My Course Schedules";
}
<style>
    .table td, .table th { vertical-align: middle; }
</style>
<div class="container-fluid">
    <h1><i class="fas fa-calendar-alt"></i> My Course Schedules</h1>
    <hr />
    @if (!Model.Any())
    {
        <div class="alert alert-info">No schedules have been assigned to your courses yet.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Course</th>
                            <th>Day</th>
                            <th>Time</th>
                            <th>Room</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.Course?.CourseName</td>
                                <td>@s.Day</td>
                                <td>@s.Time</td>
                                <td>@s.Room</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    <div class="mt-3">
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>
