@model IEnumerable<UM_Project.Models.Course>
@{
    ViewData["Title"] = "Professor Dashboard";
    var professorName = ViewBag.ProfessorName as string ?? "Professor";
    var professorEmail = ViewBag.ProfessorEmail as string ?? "";
    var professorDepartment = ViewBag.ProfessorDepartment as string ?? "N/A";
}

<style>
    /* ========== ADVANCED UI & ANIMATIONS ========== */
    :root {
        --primary-dark: #011425;
        --primary-medium: #1F4959;
        --primary-light: #5C7C89;
        --white: #FFFFFF;
        --gradient: linear-gradient(135deg, #1F4959, #011425);
        --glass-bg: rgba(255, 255, 255, 0.1);
        --glass-border: rgba(255, 255, 255, 0.2);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #f0f2f5 0%, #e8edf2 100%);
        font-family: 'Poppins', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .fade-in {
        animation: fadeInUp 0.6s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Profile Card */
    .profile-card {
        background: var(--gradient);
        border-radius: 40px;
        padding: 30px;
        margin-top: 24px;
        margin-bottom: 40px;
        color: white;
        box-shadow: 0 20px 35px -10px rgba(0,0,0,0.2);
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
        animation: slideInLeft 0.7s ease-out;
    }

    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-30px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .profile-card::before {
        content: '';
        position: absolute;
        top: -30%;
        right: -10%;
        width: 280px;
        height: 280px;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        border-radius: 50%;
        animation: pulseGlow 4s infinite;
    }

    @@keyframes pulseGlow {
        0% { transform: scale(0.9); opacity: 0.4; }
        50% { transform: scale(1.1); opacity: 0.7; }
        100% { transform: scale(0.9); opacity: 0.4; }
    }

    .profile-avatar {
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(6px);
        width: 85px;
        height: 85px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.8rem;
        transition: transform 0.3s;
        border: 2px solid rgba(255,255,255,0.3);
    }

    .profile-avatar:hover {
        transform: scale(1.05);
        background: rgba(255,255,255,0.3);
    }

    .stats-card {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(8px);
        border-radius: 32px;
        padding: 12px 28px;
        text-align: center;
        transition: all 0.3s;
        border: 1px solid rgba(255,255,255,0.2);
    }

    .stats-card:hover {
        transform: translateY(-3px);
        background: rgba(255,255,255,0.25);
    }

    /* Section Header */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 30px;
        animation: fadeInUp 0.5s ease-out;
    }

    .section-title {
        font-size: 1.8rem;
        font-weight: 700;
        background: linear-gradient(135deg, #011425, #1F4959);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .section-title i {
        font-size: 2rem;
        background: var(--gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    /* Course Cards Grid */
    .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
        margin-bottom: 50px;
    }

    .course-card {
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(2px);
        border-radius: 28px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        border: 1px solid rgba(255,255,255,0.5);
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        animation: fadeInUp 0.5s ease-out backwards;
    }

    .course-card:nth-child(1) { animation-delay: 0.05s; }
    .course-card:nth-child(2) { animation-delay: 0.1s; }
    .course-card:nth-child(3) { animation-delay: 0.15s; }
    .course-card:nth-child(4) { animation-delay: 0.2s; }

    .course-card:hover {
        transform: translateY(-6px);
        background: white;
        box-shadow: 0 25px 35px -12px rgba(0,0,0,0.2);
        border-color: rgba(31,73,89,0.2);
    }

    .course-header {
        background: linear-gradient(145deg, #f8faff, #ffffff);
        padding: 18px 22px;
        border-bottom: 1px solid #edf2f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .course-code {
        font-weight: 800;
        font-size: 1.2rem;
        color: #1e3c72;
    }

    .course-name {
        font-size: 0.9rem;
        color: #6c86a3;
        margin-top: 4px;
    }

    .course-icon {
        width: 48px;
        height: 48px;
        background: linear-gradient(145deg, #1F4959, #011425);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.4rem;
        transition: all 0.3s;
    }

    .course-card:hover .course-icon {
        transform: rotate(4deg) scale(1.05);
        box-shadow: 0 8px 18px rgba(0,0,0,0.15);
    }

    .course-body {
        padding: 18px 22px;
    }

    .info-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
        font-size: 0.9rem;
        color: #4a5b7a;
    }

    .info-row i {
        width: 22px;
        color: #1F4959;
    }

    .btn-course {
        display: inline-block;
        margin-top: 16px;
        padding: 8px 18px;
        background: linear-gradient(135deg, #1F4959, #011425);
        color: white;
        border-radius: 40px;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.25s;
        border: none;
        text-align: center;
    }

    .btn-course:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.15);
        color: white;
    }

    .action-buttons {
        margin-top: 20px;
        display: flex;
        gap: 15px;
        justify-content: flex-end;
    }

    .btn-custom {
        padding: 10px 26px;
        border-radius: 60px;
        font-weight: 600;
        transition: all 0.25s ease;
    }

    .btn-custom:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 18px rgba(0,0,0,0.15);
    }

    @@media (max-width: 768px) {
        .courses-grid {
            grid-template-columns: 1fr;
        }
        .section-header {
            flex-direction: column;
            align-items: stretch;
            gap: 15px;
        }
    }
</style>

<div class="container-fluid fade-in">
    <!-- Profile Card -->
    <div class="profile-card">
        <div class="row align-items-center gy-3">
            <div class="col-auto">
                <div class="profile-avatar">
                    <i class="fas fa-chalkboard-user"></i>
                </div>
            </div>
            <div class="col">
                <h2 class="fw-bold mb-1">Welcome, @professorName!</h2>
                <p class="mb-0"><i class="fas fa-envelope me-2"></i>@professorEmail</p>
                <p class="mb-0"><i class="fas fa-building me-2"></i>Department: @professorDepartment</p>
            </div>
            <div class="col-auto">
                <div class="stats-card">
                    <div class="fs-1 fw-bold">@Model.Count()</div>
                    <div class="small text-uppercase opacity-75">Courses</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section Header -->
    <div class="section-header">
        <div class="section-title">
            <i class="fas fa-book-open"></i>
            <span>My Courses</span>
        </div>
        <div class="action-buttons">
            <a asp-action="Schedules" class="btn btn-outline-primary btn-custom">
                <i class="fas fa-calendar-week me-2"></i>View My Schedules
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-info-circle fa-3x mb-3 d-block"></i>
            <h5>You are not assigned to any courses yet.</h5>
            <p>Please contact the administrator.</p>
        </div>
    }
    else
    {
        <div class="courses-grid">
            @foreach (var course in Model)
            {
                <div class="course-card">
                    <div class="course-header">
                        <div>
                            <div class="course-code">@course.CourseCode</div>
                            <div class="course-name">@course.CourseName</div>
                        </div>
                        <div class="course-icon">
                            <i class="fas fa-chalkboard"></i>
                        </div>
                    </div>
                    <div class="course-body">
                        <div class="info-row">
                            <i class="fas fa-building"></i>
                            <span>Department: @(course.Department?.DepartmentName ?? "N/A")</span>
                        </div>
                        <div class="info-row">
                            <i class="fas fa-credit-card"></i>
                            <span>Credits: @course.Credits</span>
                        </div>
                        <a asp-action="CourseStudents" asp-route-id="@course.CourseId" class="btn-course">
                            <i class="fas fa-users me-1"></i> View Students & Grades
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
