@model IEnumerable<UM_Project.Models.Course>
@{
    ViewData["Title"] = Localizer["Nav_Dashboard"];
}

<div class="role-dash dash-shell">
    <header class="role-dash-header">
        <div>
            <p class="role-dash-eyebrow"><i class="fas fa-chalkboard-teacher"></i> @Localizer["Dash_FacultyPortal"]</p>
            <h1>@ViewBag.ProfessorName</h1>
            <p class="dash-hero-sub mb-0">@ViewBag.ProfessorEmail · @ViewBag.ProfessorDepartment</p>
        </div>
        <div class="role-stat-row">
            <div class="role-stat-pill"><div class="num">@Model.Count()</div><div class="lbl">@Localizer["Nav_Courses"]</div></div>
            <div class="role-stat-pill"><div class="num">@ViewBag.EnrollmentCount</div><div class="lbl">@Localizer["Nav_Students"]</div></div>
        </div>
    </header>

    <div class="role-metrics">
        <div class="role-metric"><div class="val">@ViewBag.AverageGrade</div><div class="lbl">@Localizer["Dash_ClassAvgGrade"]</div></div>
        <div class="role-metric role-metric--pass"><div class="val">@ViewBag.PassingStudents</div><div class="lbl">@Localizer["Dash_PassingStudents"]</div></div>
        <div class="role-metric role-metric--fail"><div class="val">@ViewBag.FailingStudents</div><div class="lbl">@Localizer["Dash_FailingStudents"]</div></div>
    </div>

    <div class="section-head">
        <h2><i class="fas fa-book-open"></i> @Localizer["Dash_MyCourses"]</h2>
        <a asp-action="Schedules" class="dash-btn dash-btn--primary"><i class="fas fa-calendar-week"></i> @Localizer["Nav_MySchedules"]</a>
    </div>

    @if (!Model.Any())
    {
        <div class="role-empty"><i class="fas fa-book-open d-block"></i><p class="mb-0 fw-semibold">@Localizer["Dash_NoCoursesProfessor"]</p></div>
    }
    else
    {
        <div class="role-course-grid">
            @foreach (var course in Model)
            {
                <article class="role-prof-card">
                    <div class="card-top">
                        <div>
                            <div class="code">@course.CourseCode</div>
                            <div class="name">@course.CourseName</div>
                        </div>
                        <span class="icon-box"><i class="fas fa-chalkboard"></i></span>
                    </div>
                    <div class="card-body-inner">
                        <p class="small text-muted mb-2"><i class="fas fa-building me-1"></i>@(course.Department?.DepartmentName ?? "—") · @course.Credits @Localizer["Dash_Credits"]</p>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="CourseStudents" asp-route-id="@course.CourseId" class="dash-btn dash-btn--primary"><i class="fas fa-users"></i> @Localizer["Dash_GradesBtn"]</a>
                            <a asp-action="Attendance" asp-route-id="@course.CourseId" class="dash-btn dash-btn--soft"><i class="fas fa-clipboard-check"></i> @Localizer["Dash_AttendanceBtn"]</a>
                            <a asp-controller="Assignments" asp-action="CourseAssignments" asp-route-courseId="@course.CourseId" class="dash-btn dash-btn--soft"><i class="fas fa-tasks"></i> @Localizer["Dash_AssignmentsExams"]</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
