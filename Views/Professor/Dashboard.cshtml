@model IEnumerable<UM_Project.Models.Course>
@{
    ViewData["Title"] = Localizer["Nav_Dashboard"];
}

<div class="max-w-7xl mx-auto">
    <div class="mb-6 rounded-2xl bg-gradient-to-br from-red-900 via-red-700 to-red-500 p-6 text-white shadow-lg">
        <div class="flex flex-wrap justify-between gap-4">
            <div>
                <p class="text-sm opacity-80"><i class="fas fa-chalkboard-teacher mr-1"></i> @Localizer["Dash_FacultyPortal"]</p>
                <h1 class="text-2xl font-extrabold">@ViewBag.ProfessorName</h1>
                <p class="text-sm opacity-90">@ViewBag.ProfessorEmail · @ViewBag.ProfessorDepartment</p>
            </div>
            <div class="flex gap-3">
                <div class="rounded-xl bg-white/20 px-4 py-2 text-center">
                    <div class="text-2xl font-extrabold">@Model.Count()</div>
                    <div class="text-[10px] uppercase font-bold opacity-80">@Localizer["Nav_Courses"]</div>
                </div>
                <div class="rounded-xl bg-white/20 px-4 py-2 text-center">
                    <div class="text-2xl font-extrabold">@ViewBag.EnrollmentCount</div>
                    <div class="text-[10px] uppercase font-bold opacity-80">@Localizer["Nav_Students"]</div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-3 gap-3 mb-6">
        <div class="rounded-xl border border-red-100 bg-white p-4 text-center shadow-sm">
            <div class="text-xl font-bold text-red-800">@ViewBag.AverageGrade</div>
            <div class="text-xs text-gray-500 font-semibold">@Localizer["Dash_ClassAvgGrade"]</div>
        </div>
        <div class="rounded-xl border border-green-200 bg-green-50 p-4 text-center">
            <div class="text-xl font-bold text-green-800">@ViewBag.PassingStudents</div>
            <div class="text-xs text-green-700 font-semibold">@Localizer["Dash_PassingStudents"]</div>
        </div>
        <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-center">
            <div class="text-xl font-bold text-red-800">@ViewBag.FailingStudents</div>
            <div class="text-xs text-red-700 font-semibold">@Localizer["Dash_FailingStudents"]</div>
        </div>
    </div>

    <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
        <h2 class="text-lg font-extrabold text-red-900"><i class="fas fa-book-open mr-2"></i>@Localizer["Dash_MyCourses"]</h2>
        <a asp-action="Schedules" class="inline-flex items-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-bold text-white hover:bg-red-700">
            <i class="fas fa-calendar-week"></i> @Localizer["Nav_MySchedules"]
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-dashed border-red-200 p-10 text-center text-gray-600">
            <p class="font-semibold">@Localizer["Dash_NoCoursesProfessor"]</p>
        </div>
    }
    else
    {
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var course in Model)
            {
                <div class="rounded-2xl border border-red-100 bg-white overflow-hidden shadow-sm hover:shadow-md transition">
                    <div class="bg-red-50 px-4 py-3 flex justify-between items-start border-b border-red-100">
                        <div>
                            <div class="font-extrabold text-red-900">@course.CourseCode</div>
                            <div class="text-sm text-gray-600">@course.CourseName</div>
                        </div>
                        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-600 text-white"><i class="fas fa-chalkboard"></i></span>
                    </div>
                    <div class="p-4">
                        <p class="text-xs text-gray-500 mb-3"><i class="fas fa-building mr-1"></i>@(course.Department?.DepartmentName ?? "—") · @course.Credits @Localizer["Dash_Credits"]</p>
                        <div class="grid grid-cols-2 gap-2">
                            <a asp-action="CourseStudents" asp-route-id="@course.CourseId"
                               class="flex items-center justify-center gap-1 rounded-xl bg-red-600 py-2.5 text-xs font-bold text-white hover:bg-red-700 no-underline">
                                <i class="fas fa-users"></i> @Localizer["Dash_GradesBtn"]
                            </a>
                            <a asp-action="Attendance" asp-route-id="@course.CourseId"
                               class="flex items-center justify-center gap-1 rounded-xl border-2 border-red-600 py-2.5 text-xs font-bold text-red-700 hover:bg-red-50 no-underline">
                                <i class="fas fa-clipboard-check"></i> @Localizer["Dash_AttendanceBtn"]
                            </a>
                        </div>
                        <a asp-controller="Assignments" asp-action="CourseAssignments" asp-route-courseId="@course.CourseId"
                           class="mt-2 flex w-full items-center justify-center gap-1 rounded-lg border border-red-100 py-2 text-xs font-semibold text-red-800 hover:bg-red-50 no-underline">
                            <i class="fas fa-tasks"></i> @Localizer["Dash_AssignmentsExams"]
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
