@model IEnumerable<UM_Project.Models.Student>
@{
    var course = ViewBag.Course as UM_Project.Models.Course;
    var grades = ViewBag.Grades as Dictionary<int, UM_Project.Models.Grade> ?? new Dictionary<int, UM_Project.Models.Grade>();
    ViewData["Title"] = $"Students - {course?.CourseName}";
}
<style>
    .btn-xs { padding: 0.2rem 0.5rem; font-size: 0.7rem; border-radius: 0.2rem; }
    .grade-pass { color: green; font-weight: bold; }
    .grade-fail { color: red; font-weight: bold; }
</style>
<div class="container-fluid">
    <h1>@course?.CourseCode - @course?.CourseName</h1>
    <h3>Enrolled Students</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <input type="text" id="searchInput" class="form-control" placeholder="Search by student name, number or email..." />
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0" id="studentsTable">
                <thead class="table-dark">
                    <tr>
                        <th>Student ID</th>
                        <th>Name</th>
                        <th>Number</th>
                        <th>Email</th>
                        <th>Current Grade</th>
                        <th>Set Grade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        var grade = grades.ContainsKey(student.StudentId) ? grades[student.StudentId] : null;
                        <tr>
                            <td>@student.StudentId</td>
                            <td>@student.FullName</td>
                            <td>@student.StudentNumber</td>
                            <td>@student.Email</td>
                            <td>
                                @if (grade != null)
                                {
                                    if (grade.Value >= 6)
                                    {
                                        <span class="grade-pass">@grade.Value (PASS)</span>
                                    }
                                    else
                                    {
                                        <span class="grade-fail">@grade.Value (FAIL)</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Not graded</span>
                                }
                             </td>
                            <td>
                                @if (grade == null)
                                {
                                    <form asp-action="SetGrade" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="studentId" value="@student.StudentId" />
                                        <input type="hidden" name="courseId" value="@course?.CourseId" />
                                        <input type="number" name="gradeValue" class="form-control form-control-sm" style="width: 80px;" min="5" max="10" step="1" required />
                                        <button type="submit" class="btn btn-primary btn-xs">Save</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">Already graded</span>
                                }
                             </td
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>
<script>
    document.getElementById('searchInput').addEventListener('keyup', function() {
        var filter = this.value.toLowerCase();
        var rows = document.querySelectorAll('#studentsTable tbody tr');
        rows.forEach(row => {
            var text = row.textContent.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    });
</script>
