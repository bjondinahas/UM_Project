@model IEnumerable<UM_Project.Models.Student>
@{
    var course = ViewBag.Course as UM_Project.Models.Course;
    var grades = ViewBag.Grades as Dictionary<int, UM_Project.Models.Grade> ?? new Dictionary<int, UM_Project.Models.Grade>();
    ViewData["Title"] = $"Students — {course?.CourseName}";
    ViewData["PageTitle"] = $"{course?.CourseCode} — Enrolled students";
    ViewData["PageIcon"] = "fa-users";
    ViewData["PageSubtitle"] = course?.CourseName;
    ViewData["ShowCreate"] = false;
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar">
            <input type="text" id="searchInput" class="form-control" placeholder="@Localizer["Placeholder_SearchStudents"]" />
        </div>
        <div class="table-responsive">
            <table class="um-table" id="dataTable">
                <thead>
                    <tr><th>@Localizer["Table_Name"]</th><th>@Localizer["Label_Number"]</th><th>@Localizer["Table_Email"]</th><th>@Localizer["Table_Grade"]</th><th>@Localizer["Label_SetGrade"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        var grade = grades.GetValueOrDefault(student.StudentId);
                        <tr>
                            <td class="fw-semibold">@student.FullName</td>
                            <td>@student.StudentNumber</td>
                            <td>@student.Email</td>
                            <td>
                                @if (grade != null)
                                {
                                    <span class="um-badge @(grade.Value >= ViewBag.GradePassingMin ? "um-badge-green" : "um-badge-red")">@grade.Value</span>
                                }
                                else { <span class="text-muted small">—</span> }
                            </td>
                            <td>
                                @if (grade == null)
                                {
                                    <form asp-action="SetGrade" method="post" class="d-flex gap-1 align-items-center">
                                        <input type="hidden" name="studentId" value="@student.StudentId" />
                                        <input type="hidden" name="courseId" value="@course?.CourseId" />
                                        <input type="number" name="gradeValue" class="form-control form-control-sm" style="width:72px" min="@ViewBag.GradeMin" max="@ViewBag.GradeMax" required />
                                        <button type="submit" class="um-btn-sm um-btn-edit">@Localizer["Common_Save"]</button>
                                    </form>
                                }
                                else { <span class="text-muted small">@Localizer["Label_Graded"]</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex gap-2 mt-3 flex-wrap">
        <a asp-action="Attendance" asp-route-id="@course?.CourseId" class="um-btn-primary"><i class="fas fa-clipboard-check"></i> Attendance</a>
        <a asp-action="Dashboard" class="btn btn-light border"><i class="fas fa-arrow-left"></i> Dashboard</a>
    </div>
</div>
<partial name="_TableSearchScript" />
