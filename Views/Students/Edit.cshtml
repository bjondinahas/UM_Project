@model UM_Project.Models.Student
@{
    ViewData["Title"] = "Edit Student";
    ViewData["FormTitle"] = "Edit Student";
    ViewData["FormIcon"] = "fa-pen";
    var departments = ViewBag.Departments as List<UM_Project.Models.Department>;
}

<div class="um-page">
    <partial name="_AdminFormHeader" />
    <div class="um-form-panel" style="max-width:720px">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="StudentId" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="StudentNumber" />
            <input type="hidden" asp-for="UserId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="rounded-xl border border-gray-200 bg-gray-50 p-3 mb-4 text-sm">
                <p class="mb-1"><strong>Login email:</strong> @Model.Email</p>
                <p class="mb-0"><strong>Student number:</strong> @Model.StudentNumber</p>
                <p class="text-muted small mt-2 mb-0">Email and student number cannot be changed here (tied to login account).</p>
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="DepartmentId" class="form-label">Department</label>
                <select asp-for="DepartmentId" class="form-select" required>
                    @if (departments != null)
                    {
                        foreach (var dept in departments)
                        {
                            <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                        }
                    }
                </select>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="um-btn-primary"><i class="fas fa-save"></i> Save Changes</button>
                <a asp-action="Index" class="btn btn-light border">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
