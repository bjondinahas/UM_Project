@model IEnumerable<UM_Project.Models.Student>
@{
    ViewData["Title"] = Localizer["Nav_Students"];
    ViewData["PageTitle"] = Localizer["Nav_Students"];
    ViewData["PageSubtitle"] = $"{Model.Count()} {Localizer["Students_CountSuffix"]}";
    ViewData["PageIcon"] = "fa-user-graduate";
    ViewData["CreateController"] = "Students";
    ViewData["CreateText"] = Localizer["Students_Add"];
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar um-toolbar-row">
            <div class="um-search-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" class="form-control" placeholder="@Localizer["Students_SearchPlaceholder"]" />
            </div>
        </div>
        <div class="table-responsive">
            <table class="um-table um-table--students" id="dataTable">
                <thead>
                    <tr>
                        <th>@Localizer["Students_ColStudent"]</th>
                        <th>@Localizer["Students_ColEmail"]</th>
                        <th>@Localizer["Students_ColClass"]</th>
                        <th>@Localizer["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var initials = string.Join("", s.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));
                        <tr>
                            <td>
                                <div class="um-student-cell">
                                    <span class="um-student-avatar">@initials</span>
                                    <div>
                                        <span class="um-student-name">@s.FullName</span>
                                        <span class="um-student-id">@s.StudentNumber</span>
                                    </div>
                                </div>
                            </td>
                            <td><code class="um-email">@s.Email</code></td>
                            <td><span class="um-link-pill">@(s.Department?.DepartmentName ?? "—")</span></td>
                            <td>
                                <div class="um-actions">
                                    <a asp-action="Details" asp-route-id="@s.StudentId" class="um-btn-sm um-btn-view">@Localizer["Common_View"]</a>
                                    <a asp-action="Edit" asp-route-id="@s.StudentId" class="um-btn-sm um-btn-edit">@Localizer["Common_Edit"]</a>
                                    <button type="button" class="um-btn-sm um-btn-delete" onclick="showDeleteModal('@s.StudentId', '@s.FullName')"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<partial name="_DeleteModal" />
<partial name="_TableSearchScript" />
