@model IEnumerable<UM_Project.Models.Student>
@{
    ViewData["Title"] = "Students";
    ViewData["PageTitle"] = "Students";
    ViewData["PageIcon"] = "fa-user-graduate";
    ViewData["PageSubtitle"] = "Manage student records and department assignments";
    ViewData["CreateController"] = "Students";
    ViewData["CreateText"] = "Register student";
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar">
            <input type="text" id="searchInput" class="form-control" placeholder="Search by name, email or student number..." />
        </div>
        <div class="table-responsive">
            <table class="um-table" id="dataTable">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Student #</th>
                        <th>Department</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><span class="um-badge um-badge-gray">@s.StudentNumber</span></td>
                            <td class="fw-semibold">@s.FullName</td>
                            <td><code class="small">@s.Email</code></td>
                            <td>@(s.Department?.DepartmentName ?? "—")</td>
                            <td>
                                <div class="um-actions">
                                    <a asp-action="Details" asp-route-id="@s.StudentId" class="um-btn-sm um-btn-edit"><i class="fas fa-eye"></i> Profile</a>
                                    <a asp-action="Edit" asp-route-id="@s.StudentId" class="um-btn-sm um-btn-edit"><i class="fas fa-pen"></i></a>
                                    <button type="button" class="um-btn-sm um-btn-delete" onclick="showDeleteModal('@s.StudentId', '@s.FullName')"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<partial name="_DeleteModal" />
<partial name="_TableSearchScript" />
