@model UM_Project.Models.StudentDetailViewModel
@{
    ViewData["Title"] = Model.Student.FullName;
    var s = Model.Student;
}

<div class="um-page um-student-profile">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <a asp-action="Index" class="um-link-back mb-2 inline-block"><i class="fas fa-arrow-left me-1"></i> @Localizer["Common_AllStudents"]</a>
            <h1>@s.FullName</h1>
            <p class="text-gray-500">@s.StudentNumber · @s.Email · @(s.Department?.DepartmentName ?? "—")</p>
        </div>
        <div class="flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@s.StudentId" class="um-btn-primary"><i class="fas fa-pen"></i> @Localizer["Common_Edit"]</a>
            <a asp-controller="Statistics" asp-action="Index" asp-route-search="@s.FullName" class="btn btn-light border fw-semibold"><i class="fas fa-chart-line"></i> @Localizer["Nav_Analytics"]</a>
        </div>
    </div>

    <div class="um-stat-grid">
        <div class="um-stat-card">
            <div class="um-stat-value">@Model.Enrollments.Count</div>
            <div class="um-stat-label">@Localizer["Label_CoursesCount"]</div>
        </div>
        <div class="um-stat-card">
            <div class="um-stat-value">@(Model.AverageGrade?.ToString("0.00") ?? "—")</div>
            <div class="um-stat-label">@Localizer["Label_AvgGrade"]</div>
        </div>
        <div class="um-stat-card um-stat-card--ok">
            <div class="um-stat-value">@Model.PassedCount</div>
            <div class="um-stat-label">@Localizer["Label_Passed"]</div>
        </div>
        <div class="um-stat-card um-stat-card--warn">
            <div class="um-stat-value">@Model.FailedCount</div>
            <div class="um-stat-label">@Localizer["Label_Failed"]</div>
        </div>
    </div>

    <div class="um-profile-grid">
        <div class="um-profile-card">
            <h3><i class="fas fa-book me-2"></i>@Localizer["Label_CoursesAndProfessors"]</h3>
            @if (!Model.Enrollments.Any())
            {
                <p class="text-muted small">@Localizer["Msg_NotEnrolledYet"]</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="um-table table-sm">
                        <thead><tr><th>@Localizer["Label_Course"]</th><th>@Localizer["Table_Professor"]</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var e in Model.Enrollments)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@e.Course?.CourseCode</span><br />
                                        <span class="small text-muted">@e.Course?.CourseName</span>
                                    </td>
                                    <td>@(e.Course?.Professor?.FullName ?? "—")</td>
                                    <td>
                                        <form asp-action="UnenrollCourse" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="studentId" value="@s.StudentId" />
                                            <input type="hidden" name="enrollmentId" value="@e.EnrollmentId" />
                                            <button type="submit" class="um-btn-sm um-btn-delete" title="@Localizer["Title_RemoveEnrollment"]"><i class="fas fa-times"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.AvailableCourses.Any())
            {
                <form asp-action="EnrollCourse" method="post" class="mt-3 d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="studentId" value="@s.StudentId" />
                    <select name="courseId" class="form-select form-select-sm flex-grow-1" required>
                        <option value="">@Localizer["Msg_AddToCourse"]</option>
                        @foreach (var c in Model.AvailableCourses)
                        {
                            <option value="@c.CourseId">@c.CourseCode — @c.CourseName (@(c.Professor?.FullName ?? Localizer["Label_Tba"]))</option>
                        }
                    </select>
                    <button type="submit" class="um-btn-sm um-btn-edit">@Localizer["Common_Enroll"]</button>
                </form>
            }
        </div>

        <!-- Parents -->
        <div class="um-profile-card">
            <h3><i class="fas fa-people-roof me-2"></i>@Localizer["Label_ParentsGuardians"]</h3>
            @if (!Model.Parents.Any())
            {
                <p class="text-muted small mb-3">@Localizer["Msg_NoParentLinked"]</p>
            }
            @foreach (var p in Model.Parents)
            {
                <div class="border border-red-50 rounded-lg p-3 mb-2">
                    <div class="fw-semibold">@p.FullName</div>
                    <div class="small text-muted">@p.Email</div>
                </div>
            }
            <p class="small text-muted mb-2">
                <a asp-controller="Parents" asp-action="AssignChild" asp-route-studentId="@s.StudentId" class="um-link-pill">@Localizer["Msg_AssignExistingParent"]</a>
                (use student # in the list if names are duplicated).
            </p>
            <form asp-action="LinkParent" method="post" class="mt-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="studentId" value="@s.StudentId" />
                <div class="row g-2">
                    <div class="col-md-5">
                        <input type="text" name="parentFullName" class="form-control form-control-sm" placeholder="@Localizer["Label_ParentFullName"]" required />
                    </div>
                    <div class="col-md-5">
                        <input type="email" name="parentEmail" class="form-control form-control-sm" placeholder="@Localizer["Label_ParentEmailOptional"]" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="um-btn-sm um-btn-edit w-100">@Localizer["Common_Add"]</button>
                    </div>
                </div>
            </form>
            <p class="text-xs text-muted mt-2 mb-0">@Localizer["Msg_ParentEmailHint2"] <code>par.*</code> address, or use an existing parent email to link.</p>
        </div>
    </div>

    <!-- Grades -->
    <div class="um-profile-card mb-6">
        <h3><i class="fas fa-star me-2"></i>@Localizer["Label_GradesSection"]</h3>
        @if (!Model.Grades.Any())
        {
            <p class="text-muted">@Localizer["Msg_NoGradesRecorded"]</p>
        }
        else
        {
            <table class="um-table">
                <thead><tr><th>@Localizer["Label_Course"]</th><th>@Localizer["Table_Professor"]</th><th>@Localizer["Table_Grade"]</th><th>@Localizer["Label_Status"]</th><th>@Localizer["Table_Date"]</th></tr></thead>
                <tbody>
                    @foreach (var g in Model.Grades.OrderByDescending(x => x.DateRecorded))
                    {
                        <tr>
                            <td>@g.Course?.CourseName</td>
                            <td>@g.Course?.Professor?.FullName</td>
                            <td><span class="um-badge @(g.Value >= (ViewBag.GradePassingMin ?? 3) ? "um-badge-green" : "um-badge-red")">@g.Value</span></td>
                            <td>@(g.Value >= (ViewBag.GradePassingMin ?? 3) ? Localizer["Status_Pass"] : Localizer["Status_Fail"])</td>
                            <td class="small">@g.DateRecorded.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- Reset password -->
    <div class="um-profile-card um-profile-card--amber">
        <h3><i class="fas fa-key me-2"></i>@Localizer["Label_ResetPassword"]</h3>
        <p class="small text-muted mb-3">@Localizer["Msg_ForgotPasswordDefault"] <code>@Model.DefaultPassword</code></p>
        <form asp-action="ResetPassword" method="post" class="row g-2 align-items-end max-w-xl">
            @Html.AntiForgeryToken()
            <input type="hidden" name="studentId" value="@s.StudentId" />
            <div class="col-md-5">
                <label class="form-label small">@Localizer["Label_NewPasswordDefault"]</label>
                <input type="text" name="newPassword" class="form-control form-control-sm" placeholder="@Model.DefaultPassword" />
            </div>
            <div class="col-md-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="requireChange" value="true" checked id="reqCh" />
                    <label class="form-check-label small" for="reqCh">@Localizer["Label_MustChangeLogin"]</label>
                </div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="um-btn-primary w-100 justify-content-center"><i class="fas fa-key"></i> @Localizer["Label_ResetPassword"]</button>
            </div>
        </form>
    </div>
</div>
