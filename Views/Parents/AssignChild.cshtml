@{
    ViewData["Title"] = Localizer["Page_AssignChild"];
    ViewData["FormTitle"] = Localizer["Page_AssignChild"];
    ViewData["FormIcon"] = "fa-child";
    var parents = ViewBag.ParentGuardianId as SelectList;
    var students = ViewBag.StudentId as SelectList;
    var preselected = ViewBag.PreselectedStudentLabel as string;
}

<div class="um-page">
    <partial name="_AdminFormHeader" />
    <div class="um-form-panel" style="max-width:640px">
        @if (!string.IsNullOrEmpty(preselected))
        {
            <div class="alert alert-info py-2 small mb-3">
                Assigning to student: <strong>@preselected</strong> — pick the exact row below (student # disambiguates same names).
            </div>
        }
        <form asp-action="AssignChild" method="post" id="assignChildForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <div class="mb-3">
                <label class="form-label">@Localizer["Label_ParentAccount"]</label>
                <select name="parentGuardianId" id="parentSelect" class="form-select" asp-items="parents" required>
                    <option value="">@Localizer["Form_SelectParent"]</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label">@Localizer["Label_StudentChild"]</label>
                <select name="studentId" id="studentSelect" class="form-select" asp-items="students" required>
                    <option value="">@Localizer["Form_SelectStudentDisambig"]</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="um-btn-primary" id="assignBtn"><i class="fas fa-link"></i> Assign</button>
                <a asp-action="Index" class="btn btn-light border">@Localizer["Common_Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('assignChildForm').addEventListener('submit', function (e) {
            const student = document.getElementById('studentSelect');
            const parent = document.getElementById('parentSelect');
            if (!student.value || !parent.value) return;
            const studentLabel = student.options[student.selectedIndex].text;
            const parentLabel = parent.options[parent.selectedIndex].text;
            if (!confirm('@Localizer["Confirm_LinkStudentParent"]\n\nStudent: ' + studentLabel + '\nParent: ' + parentLabel)) {
                e.preventDefault();
            }
        });
    </script>
}
