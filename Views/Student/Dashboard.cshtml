@model IEnumerable<UM_Project.Models.Enrollment>
@{
    ViewData["Title"] = Localizer["Nav_Dashboard"];
    var grades = ViewBag.Grades as Dictionary<int, UM_Project.Models.Grade> ?? new();
    var lblNotGraded = Localizer["Dash_NotGraded"];
    var lblPass = Localizer["Dash_Pass"];
    var lblFail = Localizer["Dash_Fail"];
    var lblNotScheduled = Localizer["Dash_NotScheduled"];
}

<div class="role-dash dash-shell">
    <header class="role-dash-header">
        <div>
            <p class="role-dash-eyebrow"><i class="fas fa-user-graduate"></i> @Localizer["Dash_StudentPortal"]</p>
            <h1>@ViewBag.StudentName</h1>
            <p class="dash-hero-sub mb-0">ID: @ViewBag.StudentNumber · @ViewBag.Department</p>
        </div>
        <div class="role-stat-row">
            <div class="role-stat-pill"><div class="num">@Model.Count()</div><div class="lbl">@Localizer["Nav_Courses"]</div></div>
            <div class="role-stat-pill"><div class="num">@ViewBag.AverageGrade</div><div class="lbl">@Localizer["Table_AvgGrade"]</div></div>
        </div>
    </header>

    <div class="role-metrics">
        <div class="role-metric role-metric--pass"><div class="val">@ViewBag.PassedCourses</div><div class="lbl">@Localizer["Dash_Passed"]</div></div>
        <div class="role-metric role-metric--fail"><div class="val">@ViewBag.FailedCourses</div><div class="lbl">@Localizer["Dash_Failed"]</div></div>
        <div class="role-metric"><div class="val">@ViewBag.GradedCount</div><div class="lbl">@Localizer["Dash_Graded"]</div></div>
    </div>

    <div class="section-head">
        <h2><i class="fas fa-book-open"></i> @Localizer["Dash_MyCourses"]</h2>
        <div class="dash-page-header__actions">
            <a asp-action="MyGrades" class="dash-btn dash-btn--primary"><i class="fas fa-star"></i> @Localizer["Dash_AllGrades"]</a>
            <a asp-action="Schedules" class="dash-btn dash-btn--soft"><i class="fas fa-calendar"></i> @Localizer["Dash_Schedule"]</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="role-empty"><i class="fas fa-info-circle d-block"></i><p class="mb-0 fw-semibold">@Localizer["Dash_NoEnrollments"]</p></div>
    }
    else
    {
        <div class="role-course-grid">
            @foreach (var enrollment in Model)
            {
                var course = enrollment.Course!;
                var grade = grades.GetValueOrDefault(course.CourseId);
                var pass = grade != null && grade.Value >= 6;
                var scheduleText = course.Schedules?.Any() == true
                    ? string.Join(" · ", course.Schedules.Select(s => $"{s.Day} {s.Time}"))
                    : lblNotScheduled;

                <div class="role-course-card"
                     data-bs-toggle="modal" data-bs-target="#courseModal"
                     data-course-code="@course.CourseCode"
                     data-course-name="@course.CourseName"
                     data-professor="@(course.Professor?.FullName ?? "—")"
                     data-credits="@course.Credits"
                     data-enrolled="@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")"
                     data-grade="@(grade != null ? grade.Value.ToString() : lblNotGraded)"
                     data-status="@(grade != null ? (pass ? lblPass : lblFail) : "—")"
                     data-schedules="@scheduleText">
                    <span class="icon-box"><i class="fas fa-book"></i></span>
                    <div>
                        <div class="code">@course.CourseCode</div>
                        <div class="name">@course.CourseName</div>
                        @if (grade != null)
                        {
                            <span class="badge mt-1 @(pass ? "text-bg-success" : "text-bg-danger")" style="font-size:0.65rem;">@Localizer["Table_Grade"] @grade.Value</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="courseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-2xl border-0 overflow-hidden">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, var(--brand-500), var(--brand-600));">
                <h5 class="modal-title font-bold">@Localizer["Dash_CourseDetails"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-sm space-y-2" id="modalBody"></div>
        </div>
    </div>
</div>

<script>
    const L = {
        code: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Code"])),
        name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Name"])),
        professor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Professor"])),
        credits: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Credits"])),
        enrolled: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Enrolled"])),
        grade: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Grade"])),
        status: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Status"])),
        schedule: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Schedule"]))
    };
    document.getElementById('courseModal')?.addEventListener('show.bs.modal', e => {
        const b = e.relatedTarget;
        if (!b) return;
        document.getElementById('modalBody').innerHTML = `
            <p><strong>${L.code}:</strong> ${b.dataset.courseCode}</p>
            <p><strong>${L.name}:</strong> ${b.dataset.courseName}</p>
            <p><strong>${L.professor}:</strong> ${b.dataset.professor}</p>
            <p><strong>${L.credits}:</strong> ${b.dataset.credits}</p>
            <p><strong>${L.enrolled}:</strong> ${b.dataset.enrolled}</p>
            <p><strong>${L.grade}:</strong> ${b.dataset.grade}</p>
            <p><strong>${L.status}:</strong> ${b.dataset.status}</p>
            <p><strong>${L.schedule}:</strong> ${b.dataset.schedules}</p>`;
    });
</script>
