@model IEnumerable<UM_Project.Models.Enrollment>
@{
    ViewData["Title"] = "Student Dashboard";
    var grades = ViewBag.Grades as Dictionary<int, UM_Project.Models.Grade> ?? new Dictionary<int, UM_Project.Models.Grade>();
    var studentName = ViewBag.StudentName as string ?? "Student";
    var studentNumber = ViewBag.StudentNumber as string ?? "N/A";
    var studentDepartment = (Model.FirstOrDefault()?.Course?.Department?.DepartmentName) ?? "N/A";
}

<style>
   
    :root {
        --primary-dark: #011425;
        --primary-medium: #1F4959;
        --primary-light: #5C7C89;
        --white: #FFFFFF;
        --gradient: linear-gradient(135deg, #1F4959, #011425);
        --glass-bg: rgba(255, 255, 255, 0.1);
        --glass-border: rgba(255, 255, 255, 0.2);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #f0f2f5 0%, #e8edf2 100%);
        font-family: 'Poppins', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Container fade-in */
    .fade-in {
        animation: fadeInUp 0.6s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Profile Card */
    .profile-card {
        background: var(--gradient);
        border-radius: 40px;
        padding: 30px;
        margin-top: 24px;
        margin-bottom: 40px;
        color: white;
        box-shadow: 0 20px 35px -10px rgba(0,0,0,0.2);
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
        animation: slideInLeft 0.7s ease-out;
    }

    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-30px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .profile-card::before {
        content: '';
        position: absolute;
        top: -30%;
        right: -10%;
        width: 280px;
        height: 280px;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        border-radius: 50%;
        animation: pulseGlow 4s infinite;
    }

    @@keyframes pulseGlow {
        0% { transform: scale(0.9); opacity: 0.4; }
        50% { transform: scale(1.1); opacity: 0.7; }
        100% { transform: scale(0.9); opacity: 0.4; }
    }

    .profile-avatar {
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(6px);
        width: 85px;
        height: 85px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.8rem;
        transition: transform 0.3s;
        border: 2px solid rgba(255,255,255,0.3);
    }

    .profile-avatar:hover {
        transform: scale(1.05);
        background: rgba(255,255,255,0.3);
    }

    .stats-card {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(8px);
        border-radius: 32px;
        padding: 12px 28px;
        text-align: center;
        transition: all 0.3s;
        border: 1px solid rgba(255,255,255,0.2);
    }

    .stats-card:hover {
        transform: translateY(-3px);
        background: rgba(255,255,255,0.25);
    }


    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 30px;
        animation: fadeInUp 0.5s ease-out;
    }

    .section-title {
        font-size: 1.8rem;
        font-weight: 700;
        background: linear-gradient(135deg, #011425, #1F4959);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .section-title i {
        font-size: 2rem;
        background: var(--gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .action-buttons {
        display: flex;
        gap: 16px;
    }

    .btn-custom {
        padding: 10px 26px;
        border-radius: 60px;
        font-weight: 600;
        transition: all 0.25s ease;
        letter-spacing: 0.3px;
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

    .btn-custom::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: rgba(255,255,255,0.2);
        transition: left 0.3s;
        z-index: -1;
    }

    .btn-custom:hover::before {
        left: 0;
    }

    .btn-custom:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 18px rgba(0,0,0,0.15);
    }

    /* Course Cards Grid */
    .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 25px;
        margin-bottom: 50px;
    }

    .course-card {
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(2px);
        border-radius: 28px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        cursor: pointer;
        border: 1px solid rgba(255,255,255,0.5);
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 20px 24px;
        animation: fadeInUp 0.5s ease-out backwards;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .course-card:nth-child(1) { animation-delay: 0.05s; }
    .course-card:nth-child(2) { animation-delay: 0.1s; }
    .course-card:nth-child(3) { animation-delay: 0.15s; }
    .course-card:nth-child(4) { animation-delay: 0.2s; }

    .course-card:hover {
        transform: scale(1.02) translateY(-6px);
        background: white;
        box-shadow: 0 25px 35px -12px rgba(0,0,0,0.2);
        border-color: rgba(31,73,89,0.2);
    }

    .course-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(145deg, #1F4959, #011425);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.8rem;
        transition: all 0.3s;
    }

    .course-card:hover .course-icon {
        transform: rotate(4deg) scale(1.05);
        box-shadow: 0 8px 18px rgba(0,0,0,0.2);
    }

    .course-info {
        flex: 1;
    }

    .course-code {
        font-weight: 800;
        font-size: 1.1rem;
        color: #011425;
        letter-spacing: -0.2px;
    }

    .course-name {
        font-size: 0.9rem;
        color: #5a6e8c;
        margin-top: 5px;
    }

  
    .modal-glass .modal-content {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(12px);
        border-radius: 40px;
        border: none;
        box-shadow: 0 30px 40px rgba(0,0,0,0.2);
        animation: modalScale 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }

    @@keyframes modalScale {
        from {
            opacity: 0;
            transform: scale(0.9);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .modal-glass .modal-header {
        background: linear-gradient(135deg, #1F4959, #011425);
        border-radius: 40px 40px 0 0;
        color: white;
        padding: 20px 28px;
        border: none;
    }

    .modal-detail-list {
        list-style: none;
        padding: 0;
    }

    .modal-detail-list li {
        padding: 14px 0;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        justify-content: space-between;
        font-size: 1rem;
    }

    .modal-detail-list li strong {
        color: #1F4959;
        font-weight: 600;
    }

    .modal-grade-10 {
        background: linear-gradient(135deg, #ffd700, #ffb347);
        color: #5a3e00;
        padding: 6px 20px;
        border-radius: 60px;
        font-weight: bold;
        display: inline-block;
        animation: goldPulse 1.2s infinite;
    }

    @@keyframes goldPulse {
        0% { box-shadow: 0 0 0 0 rgba(255, 215, 0, 0.4); }
        70% { box-shadow: 0 0 0 6px rgba(255, 215, 0, 0); }
        100% { box-shadow: 0 0 0 0 rgba(255, 215, 0, 0); }
    }


    @@media (max-width: 768px) {
        .courses-grid {
            grid-template-columns: 1fr;
        }
        .section-header {
            flex-direction: column;
            align-items: stretch;
            gap: 15px;
        }
        .action-buttons {
            justify-content: center;
        }
        .profile-card {
            padding: 20px;
        }
        .stats-card {
            padding: 8px 18px;
        }
    }
</style>

<div class="container-fluid fade-in">
    <!-- Profile Card -->
    <div class="profile-card">
        <div class="row align-items-center gy-3">
            <div class="col-auto">
                <div class="profile-avatar">
                    <i class="fas fa-user-astronaut"></i>
                </div>
            </div>
            <div class="col">
                <h2 class="fw-bold mb-1">@studentName</h2>
                <p class="mb-0"><i class="fas fa-id-card me-2"></i>Student ID: @studentNumber</p>
                <p class="mb-0"><i class="fas fa-building me-2"></i>Department: @studentDepartment</p>
            </div>
            <div class="col-auto">
                <div class="stats-card">
                    <div class="fs-1 fw-bold">@Model.Count()</div>
                    <div class="small text-uppercase opacity-75">Courses</div>
                </div>
            </div>
        </div>
    </div>


    <div class="section-header">
        <div class="section-title">
            <i class="fas fa-graduation-cap"></i>
            <span>My Enrolled Courses</span>
        </div>
        <div class="action-buttons">
            <a asp-action="MyGrades" class="btn btn-primary btn-custom">
                <i class="fas fa-chart-line me-2"></i>View All Grades
            </a>
            <a asp-action="Schedules" class="btn btn-outline-primary btn-custom">
                <i class="fas fa-calendar-week me-2"></i>My Schedule
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-info-circle fa-3x mb-3 d-block"></i>
            <h5>You are not enrolled in any courses yet.</h5>
            <p>Please contact the administrator for enrollment.</p>
        </div>
    }
    else
    {
        <div class="courses-grid">
            @foreach (var enrollment in Model)
            {
                var course = enrollment.Course;
                var grade = grades.ContainsKey(course.CourseId) ? grades[course.CourseId] : null;
                var gradeValue = grade?.Value ?? 0;
                var isPass = grade != null && gradeValue >= 6;
                var scheduleText = (course.Schedules != null && course.Schedules.Any())
                    ? string.Join(" • ", course.Schedules.Select(s => $"{s.Day} {s.Time} (Room {s.Room})"))
                    : "Not scheduled";

                <div class="course-card" data-bs-toggle="modal" data-bs-target="#courseModal"
                     data-course-code="@course.CourseCode"
                     data-course-name="@course.CourseName"
                     data-professor="@(course.Professor?.FullName ?? "Not assigned")"
                     data-credits="@course.Credits"
                     data-enrolled="@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")"
                     data-grade="@(grade != null ? gradeValue.ToString() : "Not graded")"
                     data-status="@(grade != null ? (isPass ? "PASS" : "FAIL") : "Not graded")"
                     data-schedules="@scheduleText"
                     data-is-grade-10="@(gradeValue == 10)">
                    <div class="course-icon">
                        <i class="fas fa-book-open"></i>
                    </div>
                    <div class="course-info">
                        <div class="course-code">@course.CourseCode</div>
                        <div class="course-name">@course.CourseName</div>
                    </div>
                </div>
            }
        </div>
    }
</div>


<div class="modal fade modal-glass" id="courseModal" tabindex="-1" aria-labelledby="courseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="courseModalLabel">
                    <i class="fas fa-info-circle me-2"></i>Course Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <ul class="modal-detail-list">
                    <li><strong>📘 Course Code:</strong> <span id="modalCourseCode"></span></li>
                    <li><strong>📖 Course Name:</strong> <span id="modalCourseName"></span></li>
                    <li><strong>👨‍🏫 Professor:</strong> <span id="modalProfessor"></span></li>
                    <li><strong>⚡ Credits:</strong> <span id="modalCredits"></span></li>
                    <li><strong>📅 Enrolled:</strong> <span id="modalEnrolled"></span></li>
                    <li><strong>⭐ Grade:</strong> <span id="modalGrade"></span></li>
                    <li><strong>🏷️ Status:</strong> <span id="modalStatus"></span></li>
                    <li><strong>⏰ Schedule:</strong> <span id="modalSchedules" class="break-word"></span></li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    var modal = document.getElementById('courseModal');
    modal.addEventListener('show.bs.modal', function(event) {
        var btn = event.relatedTarget;
        document.getElementById('modalCourseCode').innerText = btn.getAttribute('data-course-code');
        document.getElementById('modalCourseName').innerText = btn.getAttribute('data-course-name');
        document.getElementById('modalProfessor').innerText = btn.getAttribute('data-professor');
        document.getElementById('modalCredits').innerText = btn.getAttribute('data-credits');
        document.getElementById('modalEnrolled').innerText = btn.getAttribute('data-enrolled');
        var gradeVal = btn.getAttribute('data-grade');
        var isGrade10 = btn.getAttribute('data-is-grade-10') === 'True';
        var gradeSpan = document.getElementById('modalGrade');
        if (isGrade10 && gradeVal !== 'Not graded') {
            gradeSpan.innerHTML = '<span class="modal-grade-10"><i class="fas fa-trophy me-1"></i> ' + gradeVal + ' / 10 Perfect!</span>';
        } else {
            gradeSpan.innerText = gradeVal + (gradeVal !== 'Not graded' ? ' ' : '');
        }
        document.getElementById('modalStatus').innerText = btn.getAttribute('data-status');
        document.getElementById('modalSchedules').innerHTML = btn.getAttribute('data-schedules');
    });
</script>
