@model IEnumerable<UM_Project.Models.Enrollment>
@{
    ViewData["Title"] = Localizer["Nav_Dashboard"];
    var grades = ViewBag.Grades as Dictionary<int, UM_Project.Models.Grade> ?? new();
    var lblNotGraded = Localizer["Dash_NotGraded"];
    var lblPass = Localizer["Dash_Pass"];
    var lblFail = Localizer["Dash_Fail"];
    var lblNotScheduled = Localizer["Dash_NotScheduled"];
}

<div class="max-w-7xl mx-auto">
    <div class="mb-6 rounded-2xl bg-gradient-to-br from-red-900 via-red-700 to-red-500 p-6 text-white shadow-lg">
        <div class="flex flex-wrap justify-between gap-4">
            <div>
                <p class="text-sm opacity-80"><i class="fas fa-user-graduate mr-1"></i> @Localizer["Dash_StudentPortal"]</p>
                <h1 class="text-2xl font-extrabold">@ViewBag.StudentName</h1>
                <p class="text-sm opacity-90 mt-1">ID: @ViewBag.StudentNumber · @ViewBag.Department</p>
            </div>
            <div class="flex gap-3">
                <div class="rounded-xl bg-white/20 px-4 py-2 text-center">
                    <div class="text-2xl font-extrabold">@Model.Count()</div>
                    <div class="text-[10px] uppercase font-bold opacity-80">@Localizer["Nav_Courses"]</div>
                </div>
                <div class="rounded-xl bg-white/20 px-4 py-2 text-center">
                    <div class="text-2xl font-extrabold">@ViewBag.AverageGrade</div>
                    <div class="text-[10px] uppercase font-bold opacity-80">@Localizer["Table_AvgGrade"]</div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-3 gap-3 mb-6">
        <div class="rounded-xl border border-green-200 bg-green-50 p-4 text-center">
            <div class="text-xl font-bold text-green-800">@ViewBag.PassedCourses</div>
            <div class="text-xs text-green-700 font-semibold">@Localizer["Dash_Passed"]</div>
        </div>
        <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-center">
            <div class="text-xl font-bold text-red-800">@ViewBag.FailedCourses</div>
            <div class="text-xs text-red-700 font-semibold">@Localizer["Dash_Failed"]</div>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-4 text-center">
            <div class="text-xl font-bold text-gray-800">@ViewBag.GradedCount</div>
            <div class="text-xs text-gray-600 font-semibold">@Localizer["Dash_Graded"]</div>
        </div>
    </div>

    <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
        <h2 class="text-lg font-extrabold text-red-900"><i class="fas fa-book-open mr-2"></i>@Localizer["Dash_MyCourses"]</h2>
        <div class="flex gap-2">
            <a asp-action="MyGrades" class="inline-flex items-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-bold text-white hover:bg-red-700"><i class="fas fa-star"></i> @Localizer["Dash_AllGrades"]</a>
            <a asp-action="Schedules" class="inline-flex items-center gap-2 rounded-xl border border-red-200 bg-white px-4 py-2 text-sm font-bold text-red-800 hover:bg-red-50"><i class="fas fa-calendar"></i> @Localizer["Dash_Schedule"]</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-dashed border-red-200 bg-red-50/50 p-10 text-center text-gray-600">
            <i class="fas fa-info-circle text-3xl text-red-500 mb-2"></i>
            <p class="font-semibold">@Localizer["Dash_NoEnrollments"]</p>
        </div>
    }
    else
    {
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var enrollment in Model)
            {
                var course = enrollment.Course!;
                var grade = grades.GetValueOrDefault(course.CourseId);
                var pass = grade != null && grade.Value >= 6;
                var scheduleText = course.Schedules?.Any() == true
                    ? string.Join(" · ", course.Schedules.Select(s => $"{s.Day} {s.Time}"))
                    : lblNotScheduled;

                <div class="rounded-2xl border border-red-100 bg-white p-4 shadow-sm hover:shadow-md hover:border-red-300 transition cursor-pointer"
                     data-bs-toggle="modal" data-bs-target="#courseModal"
                     data-course-code="@course.CourseCode"
                     data-course-name="@course.CourseName"
                     data-professor="@(course.Professor?.FullName ?? "—")"
                     data-credits="@course.Credits"
                     data-enrolled="@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")"
                     data-grade="@(grade != null ? grade.Value.ToString() : lblNotGraded)"
                     data-status="@(grade != null ? (pass ? lblPass : lblFail) : "—")"
                     data-schedules="@scheduleText">
                    <div class="flex gap-3 items-start">
                        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-red-600 to-red-800 text-white">
                            <i class="fas fa-book"></i>
                        </span>
                        <div>
                            <div class="font-extrabold text-red-900">@course.CourseCode</div>
                            <div class="text-sm text-gray-500">@course.CourseName</div>
                            @if (grade != null)
                            {
                                <span class="inline-block mt-2 rounded-full px-2 py-0.5 text-xs font-bold @(pass ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">@Localizer["Table_Grade"] @grade.Value</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="courseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-2xl border-0 overflow-hidden">
            <div class="modal-header text-white bg-gradient-to-r from-red-800 to-red-600">
                <h5 class="modal-title font-bold">@Localizer["Dash_CourseDetails"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-sm space-y-2" id="modalBody"></div>
        </div>
    </div>
</div>

<script>
    const L = {
        code: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Code"])),
        name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Name"])),
        professor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Professor"])),
        credits: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Credits"])),
        enrolled: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Enrolled"])),
        grade: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Grade"])),
        status: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Status"])),
        schedule: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Modal_Schedule"]))
    };
    document.getElementById('courseModal')?.addEventListener('show.bs.modal', e => {
        const b = e.relatedTarget;
        if (!b) return;
        document.getElementById('modalBody').innerHTML = `
            <p><strong>${L.code}:</strong> ${b.dataset.courseCode}</p>
            <p><strong>${L.name}:</strong> ${b.dataset.courseName}</p>
            <p><strong>${L.professor}:</strong> ${b.dataset.professor}</p>
            <p><strong>${L.credits}:</strong> ${b.dataset.credits}</p>
            <p><strong>${L.enrolled}:</strong> ${b.dataset.enrolled}</p>
            <p><strong>${L.grade}:</strong> ${b.dataset.grade}</p>
            <p><strong>${L.status}:</strong> ${b.dataset.status}</p>
            <p><strong>${L.schedule}:</strong> ${b.dataset.schedules}</p>`;
    });
</script>
