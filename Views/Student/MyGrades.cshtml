@model IEnumerable<UM_Project.Models.Grade>
@{
    ViewData["Title"] = Localizer["Nav_MyGrades"];
    ViewData["PageTitle"] = Localizer["Page_MyGrades"];
    ViewData["PageIcon"] = "fa-star";
    ViewData["ShowCreate"] = false;
    double avg = Model.Any() ? Model.Average(g => g.Value) : 0;
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="table-responsive">
            <table class="um-table">
                <thead><tr><th>@Localizer["Label_Course"]</th><th>@Localizer["Table_Grade"]</th><th>@Localizer["Label_Status"]</th><th>@Localizer["Table_Date"]</th></tr></thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        var pass = g.Value >= (ViewBag.GradePassingMin ?? 3);
                        <tr>
                            <td class="fw-semibold">@g.Course?.CourseName</td>
                            <td><span class="um-badge @(pass ? "um-badge-green" : "um-badge-red")">@g.Value</span></td>
                            <td>@(pass ? "Pass" : "Fail")</td>
                            <td>@g.DateRecorded.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
                @if (Model.Any())
                {
                    <tfoot>
                        <tr class="bg-light">
                            <td class="fw-bold">@Localizer["Label_Average"]</td>
                            <td colspan="3"><span class="um-badge um-badge-red">@avg.ToString("0.00")</span> @(avg >= (ViewBag.GradePassingMin ?? 3) ? Localizer["Status_Pass"] : Localizer["Status_Fail"])</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
    <a asp-action="Dashboard" class="um-btn-primary mt-3"><i class="fas fa-arrow-left"></i> Dashboard</a>
</div>
