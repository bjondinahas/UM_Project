@model UM_Project.Models.AcademicSettingsDto
@{
    ViewData["Title"] = "Academic Settings";
}

<link rel="stylesheet" href="~/css/superadmin-hub.css" asp-append-version="true" />

<div class="sa-hub">
    <a asp-action="Hub" class="sa-back"><i class="fas fa-arrow-left"></i> Control center</a>
    <div class="sa-hero" style="padding:1.5rem;margin-bottom:1.25rem">
        <h1 style="font-size:1.35rem">Grade & attendance rules</h1>
        <p style="font-size:0.85rem">These limits apply to professors and admin grade entry.</p>
    </div>
    <div class="sa-settings-panel">
        <form asp-action="AcademicSettings" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Minimum grade</label>
                    <input asp-for="GradeMinimum" type="number" class="form-control" min="1" max="20" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Maximum grade</label>
                    <input asp-for="GradeMaximum" type="number" class="form-control" min="1" max="20" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Passing grade</label>
                    <input asp-for="GradePassingMinimum" type="number" class="form-control" min="1" max="20" required />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Lessons per school day</label>
                    <input asp-for="LessonsPerDay" type="number" class="form-control" min="1" max="12" required />
                    <div class="form-text">Attendance grid columns for professors (e.g. 6).</div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="um-btn-primary">Save settings</button>
                <a asp-action="Hub" class="btn btn-light border">Cancel</a>
            </div>
        </form>
    </div>
</div>
