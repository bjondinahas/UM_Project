@model IEnumerable<UM_Project.Models.Enrollment>
@{
    ViewData["Title"] = Localizer["Nav_Enrollments"];
    ViewData["PageTitle"] = Localizer["Nav_Enrollments"];
    ViewData["PageIcon"] = "fa-clipboard-list";
    ViewData["PageSubtitle"] = Localizer["Page_Enrollments_Subtitle"];
    ViewData["CreateController"] = "Enrollments";
    ViewData["CreateText"] = Localizer["Page_Enrollments_Create"];
}

<div class="um-page">
    <partial name="_AdminPageHeader" />
    <div class="um-panel">
        <div class="um-panel-toolbar">
            <input type="text" id="searchInput" class="form-control" placeholder="@Localizer["Search_Enrollments"]" />
        </div>
        <div class="table-responsive">
            <table class="um-table" id="dataTable">
                <thead>
                    <tr><th>@Localizer["Table_Student"]</th><th>@Localizer["Table_Course"]</th><th>@Localizer["Table_Date"]</th><th>@Localizer["Common_Actions"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@(e.Student?.FullName ?? "—")</td>
                            <td>@(e.Course?.CourseName ?? "—")</td>
                            <td>@e.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <button type="button" class="um-btn-sm um-btn-delete" onclick="showDeleteModal('@e.EnrollmentId', 'this enrollment')"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<partial name="_DeleteModal" />
<partial name="_TableSearchScript" />
