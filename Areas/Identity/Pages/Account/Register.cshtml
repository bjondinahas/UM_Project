@page
@model RegisterModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Register";
    ViewData["AuthMode"] = "register";
}

<div class="mb-8">
    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-lg shadow-brand-600/30 mb-5">
        <i class="fas fa-user-plus text-2xl"></i>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Create account</h2>
    <p class="mt-2 text-gray-500">Register to get started with University Manager</p>
</div>

<form method="post" class="space-y-5">
    <div asp-validation-summary="ModelOnly" class="rounded-xl bg-red-50 border border-red-200 text-brand-800 px-4 py-3 text-sm" role="alert"></div>

    <div>
        <label asp-for="Input.Email" class="block text-sm font-semibold text-gray-700 mb-2">
            <i class="fas fa-envelope text-brand-600 mr-1.5 w-4"></i>Email address
        </label>
        <div class="auth-input-wrap flex items-center rounded-xl border-2 border-gray-200 bg-white overflow-hidden transition">
            <span class="auth-input-icon pl-4 text-gray-400 transition">
                <i class="fas fa-at"></i>
            </span>
            <input asp-for="Input.Email" type="email" autocomplete="username"
                   class="flex-1 py-3.5 pr-4 pl-3 bg-transparent border-0 focus:ring-0 text-gray-900 placeholder-gray-400 w-full"
                   placeholder="you@university.edu" />
        </div>
        <span asp-validation-for="Input.Email" class="text-sm text-brand-600 mt-1 block"></span>
    </div>

    <div>
        <label asp-for="Input.Password" class="block text-sm font-semibold text-gray-700 mb-2">
            <i class="fas fa-key text-brand-600 mr-1.5 w-4"></i>Password
        </label>
        <div class="auth-input-wrap flex items-center rounded-xl border-2 border-gray-200 bg-white overflow-hidden transition">
            <span class="auth-input-icon pl-4 text-gray-400 transition">
                <i class="fas fa-lock"></i>
            </span>
            <input asp-for="Input.Password" type="password" autocomplete="new-password"
                   class="flex-1 py-3.5 pr-4 pl-3 bg-transparent border-0 focus:ring-0 text-gray-900 placeholder-gray-400 w-full"
                   placeholder="Create a password" />
        </div>
        <span asp-validation-for="Input.Password" class="text-sm text-brand-600 mt-1 block"></span>
    </div>

    <div>
        <label asp-for="Input.ConfirmPassword" class="block text-sm font-semibold text-gray-700 mb-2">
            <i class="fas fa-lock text-brand-600 mr-1.5 w-4"></i>Confirm password
        </label>
        <div class="auth-input-wrap flex items-center rounded-xl border-2 border-gray-200 bg-white overflow-hidden transition">
            <span class="auth-input-icon pl-4 text-gray-400 transition">
                <i class="fas fa-shield-halved"></i>
            </span>
            <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password"
                   class="flex-1 py-3.5 pr-4 pl-3 bg-transparent border-0 focus:ring-0 text-gray-900 placeholder-gray-400 w-full"
                   placeholder="Repeat your password" />
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="text-sm text-brand-600 mt-1 block"></span>
    </div>

    <button type="submit"
            class="w-full flex items-center justify-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-bold py-3.5 px-6 rounded-xl transition shadow-lg shadow-brand-600/25 hover:shadow-xl hover:-translate-y-0.5">
        <i class="fas fa-user-check"></i>
        Create account
    </button>
</form>

<div class="mt-8 pt-6 border-t border-gray-100 text-center">
    <p class="text-gray-600 text-sm">
        <i class="fas fa-right-to-bracket text-brand-500 mr-1"></i>
        Already have an account?
        <a asp-page="./Login" class="font-semibold text-brand-600 hover:text-brand-700 ml-1">Sign in</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
