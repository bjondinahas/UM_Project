@page
@model LoginModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = Localizer["Login_SignIn"];
}

<h2>@Localizer["Login_SignIn"]</h2>

<form method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

    <div class="auth-field">
        <label asp-for="Input.Email">@Localizer["Login_Email"] <span class="req">*</span></label>
        <input asp-for="Input.Email" type="email" autocomplete="username" placeholder="admin@umproject.com" />
        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
    </div>

    <div class="auth-field" style="margin-top: 1rem;">
        <label asp-for="Input.Password">@Localizer["Login_Password"] <span class="req">*</span></label>
        <input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="••••••••" />
        <span asp-validation-for="Input.Password" class="field-validation-error"></span>
    </div>

    <label class="auth-remember">
        <input asp-for="Input.RememberMe" type="checkbox" />
        @Localizer["Login_RememberMe"]
    </label>

    <button type="submit" class="auth-submit">@Localizer["Login_Submit"]</button>
</form>

<div class="auth-demo">
    <div class="auth-demo-title">@Localizer["Login_DemoTitle"]</div>
    <div class="auth-demo-badges">
        <span class="auth-demo-badge auth-demo-badge--super">@Localizer["Role_SuperAdmin"]</span>
        <span class="auth-demo-badge auth-demo-badge--admin">@Localizer["Role_Admin"]</span>
        <span class="auth-demo-badge auth-demo-badge--prof">@Localizer["Role_Professor"]</span>
        <span class="auth-demo-badge auth-demo-badge--student">@Localizer["Role_Student"]</span>
        <span class="auth-demo-badge auth-demo-badge--parent">@Localizer["Role_Parent"]</span>
    </div>
    <p class="auth-demo-hint">Fjalëkalimi: <strong>Admin@123</strong> — superadmin@umproject.com, admin@umproject.com, prof.elena.marku@umproject.edu, stu.ana.gashi@umproject.edu, par.artan.gashi@umproject.edu</p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
