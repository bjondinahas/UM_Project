@page
@model ChangePasswordModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = Model.IsRequired ? "Set your password" : "Change password";
    ViewData["AuthMode"] = "login";
}

<div class="mb-8">
    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-lg shadow-brand-600/30 mb-5">
        <i class="fas fa-key text-2xl"></i>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">@(Model.IsRequired ? "Set your password" : "Change password")</h2>
    @if (Model.IsRequired)
    {
        <p class="mt-2 text-gray-500">For security, you must choose a new password before continuing.</p>
    }
</div>

<form method="post" class="space-y-5">
    <div asp-validation-summary="ModelOnly" class="rounded-xl bg-red-50 border border-red-200 text-brand-800 px-4 py-3 text-sm"></div>

    <div>
        <label asp-for="Input.CurrentPassword" class="block text-sm font-semibold text-gray-700 mb-2">Current password</label>
        <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password"
               class="w-full rounded-xl border-2 border-gray-200 px-4 py-3 focus:border-brand-600 focus:ring-0" />
        <span asp-validation-for="Input.CurrentPassword" class="text-red-600 text-sm"></span>
        @if (Model.IsRequired)
        {
            <p class="text-xs text-gray-500 mt-1">Use the temporary password you received from the administrator.</p>
        }
    </div>

    <div>
        <label asp-for="Input.NewPassword" class="block text-sm font-semibold text-gray-700 mb-2">New password</label>
        <input asp-for="Input.NewPassword" type="password" autocomplete="new-password"
               class="w-full rounded-xl border-2 border-gray-200 px-4 py-3 focus:border-brand-600 focus:ring-0" />
        <span asp-validation-for="Input.NewPassword" class="text-red-600 text-sm"></span>
    </div>

    <div>
        <label asp-for="Input.ConfirmPassword" class="block text-sm font-semibold text-gray-700 mb-2">Confirm new password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password"
               class="w-full rounded-xl border-2 border-gray-200 px-4 py-3 focus:border-brand-600 focus:ring-0" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-red-600 text-sm"></span>
    </div>

    <button type="submit" class="w-full rounded-xl bg-brand-600 py-3.5 font-bold text-white hover:bg-brand-700 transition shadow-lg shadow-brand-600/25">
        Save new password
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
