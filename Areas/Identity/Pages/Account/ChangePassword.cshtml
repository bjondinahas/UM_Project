@page
@model ChangePasswordModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = Model.IsRequired ? Localizer["Auth_SetPassword"] : Localizer["Auth_ChangePassword"];
}

<h2>@ViewData["Title"]</h2>
<p class="auth-subtitle">
    @(Model.IsRequired ? Localizer["Auth_SetPasswordHint"] : Localizer["Auth_ChangePasswordHint"])
</p>

<form method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

    <div class="auth-field">
        <label asp-for="Input.CurrentPassword">@Localizer["Auth_CurrentPassword"] <span class="req">*</span></label>
        <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" placeholder="••••••••" />
        <span asp-validation-for="Input.CurrentPassword" class="field-validation-error"></span>
        @if (Model.IsRequired)
        {
            <p class="auth-field-hint">@Localizer["Auth_TempPasswordHint"]</p>
        }
    </div>

    <div class="auth-field">
        <label asp-for="Input.NewPassword">@Localizer["Auth_NewPassword"] <span class="req">*</span></label>
        <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
        <span asp-validation-for="Input.NewPassword" class="field-validation-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Input.ConfirmPassword">@Localizer["Auth_ConfirmPassword"] <span class="req">*</span></label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="••••••••" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
    </div>

    <button type="submit" class="auth-submit">@Localizer["Auth_SavePassword"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
