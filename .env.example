# Copy to .env and adjust before: docker compose up
# Do not commit .env to version control.

# MySQL (docker-compose service: mysql)
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=UM_ProjectDB
MYSQL_USER=umuser
MYSQL_PASSWORD=um_change_me

# Web app
WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Docker

# JWT (required — use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Optional SMTP (leave empty to skip outbound email in Docker)
SMTP_SERVER=
SMTP_PORT=587
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
